<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="container py-5 text-center">
                    <div class="card shadow-sm border-danger border-2 mx-auto" style="max-width: 550px;">
                        <div class="card-body p-4">
                            <i class="bi bi-shield-lock-fill text-danger display-3 d-block mb-3"></i>
                            <h3 class="fw-bold text-danger mb-2">Truy cập bị từ chối!</h3>
                            @if (context.User.Identity?.IsAuthenticated == true)
                            {
                                <p class="text-dark mb-2">
                                    Tài khoản <strong>@context.User.Identity?.Name</strong> (Vai trò: 
                                    <span class="badge bg-secondary">@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Chưa rõ")</span>)
                                    không có quyền hạn để truy cập trang này.
                                </p>
                                <p class="text-muted small mb-4">
                                    Vui lòng liên hệ Quản trị viên hệ thống (ADMIN) nếu bạn cần cấp thêm quyền hạn.
                                </p>
                                <a href="dashboard" class="btn btn-outline-primary px-4">
                                    <i class="bi bi-house-door me-1"></i> Quay lại Dashboard
                                </a>
                            }
                            else
                            {
                                <p class="text-muted mb-4">
                                    Bạn chưa đăng nhập hoặc phiên làm việc đã kết thúc. Vui lòng đăng nhập để tiếp tục.
                                </p>
                                <a href="login" class="btn btn-primary px-4">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </NotAuthorized>
            <Authorizing>
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Đang kiểm tra quyền truy cập...</p>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Không tìm thấy trang</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="container py-5 text-center">
                <i class="bi bi-exclamation-octagon text-warning display-4 d-block mb-3"></i>
                <h3 class="fw-bold">404 - Không tìm thấy trang</h3>
                <p class="text-muted">Đường dẫn bạn truy cập không tồn tại hoặc đã bị di chuyển.</p>
                <a href="dashboard" class="btn btn-primary">Về Trang chủ</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
