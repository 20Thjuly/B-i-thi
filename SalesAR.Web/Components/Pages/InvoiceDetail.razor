@page "/invoices/{Id:int}"
@attribute [Authorize]
@inject IViewInvoicesUseCase ViewInvoicesUseCase
@inject IViewCustomerByIdUseCase ViewCustomerByIdUseCase
@inject IViewProductsUseCase ViewProductsUseCase
@inject IViewPaymentsUseCase ViewPaymentsUseCase
@inject IBankSettingsService BankSettingsService
@inject NavigationManager Navigation

<PageTitle>Chi tiết Hóa đơn #@(_invoice?.InvoiceNumber ?? Id.ToString())</PageTitle>

<div class="container-fluid px-0">
    <div class="mb-4">
        <a href="invoices" class="text-decoration-none small text-muted d-inline-flex align-items-center mb-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách hóa đơn
        </a>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1 d-flex align-items-center flex-wrap gap-2">
                    <i class="bi bi-receipt text-primary"></i>
                    <span>Hóa đơn @_invoice?.InvoiceNumber</span>
                    @if (_invoice != null)
                    {
                        <InvoiceStatusBadge Status="@_invoice.Status" />
                    }
                </h1>
                <div class="text-muted small">
                    Ngày lập: @_invoice?.InvoiceDate.ToString("dd/MM/yyyy") | 
                    Hạn TT: @_invoice?.DueDate.ToString("dd/MM/yyyy")
                    @if (_invoice != null && _invoice.DueDate < DateTime.Today && _invoice.Status != "Paid")
                    {
                        <span class="badge badge-soft-danger ms-1">Đã quá hạn thanh toán</span>
                    }
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (_invoice != null && _invoice.Status != "Paid" && _remainingBalance > 0)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenInvoiceQrModal">
                        <i class="bi bi-qr-code me-1"></i> Quét mã VietQR
                    </button>
                    <a href="payments/create?customerId=@_invoice.CustomerId&amount=@_remainingBalance&invoiceId=@_invoice.Id" class="btn btn-success btn-sm">
                        <i class="bi bi-cash-coin me-1"></i> Thu tiền hóa đơn này
                    </a>
                }
                <a href="invoices/create" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Lập hóa đơn mới
                </a>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_invoice == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Không tìm thấy hóa đơn với ID: @Id
        </div>
    }
    else
    {
        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <DebtSummaryCard Title="Tổng tiền hóa đơn" 
                                  Amount="@_invoice.TotalAmount" 
                                  Icon="bi-receipt-cutoff" 
                                  CardClass="border-start border-primary border-4" 
                                  Subtitle="Giá trị trước/đã gồm thuế" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <DebtSummaryCard Title="Đã thanh toán" 
                                  Amount="@_totalPaid" 
                                  Icon="bi-cash-stack" 
                                  CardClass="border-start border-success border-4" 
                                  Subtitle="Tiền đã thu theo FIFO" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <DebtSummaryCard Title="Còn nợ phải thu" 
                                  Amount="@_remainingBalance" 
                                  Icon="bi-hourglass-split" 
                                  CardClass="@(_remainingBalance > 0 ? "border-start border-danger border-4" : "border-start border-success border-4")" 
                                  Subtitle="@(_remainingBalance > 0 ? "Chưa thanh toán đủ" : "Đã tất toán xong")" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold">Khách hàng</span>
                            <i class="bi bi-person text-secondary fs-5"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">
                            <a href="customers/@_customer?.Id" class="text-decoration-none">
                                @(_customer?.Name ?? "Không rõ")
                            </a>
                        </h6>
                        <div class="text-muted small">Mã: @_customer?.Code | SĐT: @_customer?.Phone</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiết sản phẩm trong hóa đơn -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-dark mb-0">
                    <i class="bi bi-box-seam text-primary me-2"></i>Danh mục Hàng hóa / Dịch vụ
                </h5>
                <span class="badge bg-light text-dark border">@_lines.Count dòng sản phẩm</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th>Mã SP</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-center">ĐVT</th>
                                <th class="text-center" style="width: 120px;">Số lượng</th>
                                <th class="text-end" style="width: 160px;">Đơn giá (VNĐ)</th>
                                <th class="text-end" style="width: 180px;">Thành tiền (VNĐ)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_lines.Any())
                            {
                                int stt = 1;
                                @foreach (var line in _lines)
                                {
                                    var prod = _products.FirstOrDefault(p => p.Id == line.ProductId);
                                    <tr>
                                        <td class="text-center text-muted">@(stt++)</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@(prod?.Code ?? line.ProductId.ToString())</span>
                                        </td>
                                        <td class="fw-semibold">@(prod?.Name ?? "Sản phẩm #" + line.ProductId)</td>
                                        <td class="text-center text-muted">@(prod?.Unit ?? "-")</td>
                                        <td class="text-center fw-bold">@line.Quantity.ToString("N0")</td>
                                        <td class="text-end">@line.UnitPrice.ToString("N0") đ</td>
                                        <td class="text-end fw-bold text-dark">@line.Amount.ToString("N0") đ</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu dòng sản phẩm.</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="6" class="text-end fw-bold">TỔNG CỘNG HÓA ĐƠN:</td>
                                <td class="text-end fw-bold text-primary fs-6">@_invoice.TotalAmount.ToString("N0") đ</td>
                            </tr>
                            <tr>
                                <td colspan="6" class="text-end fw-semibold text-muted">Đã thanh toán (lũy kế):</td>
                                <td class="text-end fw-semibold text-success">-@_totalPaid.ToString("N0") đ</td>
                            </tr>
                            <tr class="table-active">
                                <td colspan="6" class="text-end fw-bold">SỐ TIỀN CÒN PHẢI THU:</td>
                                <td class="text-end fw-bold @(_remainingBalance > 0 ? "text-danger" : "text-success") fs-5">
                                    @_remainingBalance.ToString("N0") đ
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Lịch sử các đợt thanh toán phân bổ cho hóa đơn này -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-dark mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử Phân bổ Thanh toán (FIFO)
                </h5>
                <span class="badge bg-light text-dark border">@_allocations.Count đợt phân bổ</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã phân bổ</th>
                                <th>Phiếu thu</th>
                                <th>Ngày thu tiền</th>
                                <th class="text-end">Số tiền phân bổ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_allocations.Any())
                            {
                                @foreach (var alloc in _allocations)
                                {
                                    var payment = _payments.FirstOrDefault(p => p.Id == alloc.PaymentId);
                                    <tr>
                                        <td class="fw-bold">#@alloc.Id</td>
                                        <td>
                                            <span class="fw-semibold text-dark">
                                                @(payment?.PaymentNumber ?? $"PT #{alloc.PaymentId}")
                                            </span>
                                            @if (!string.IsNullOrEmpty(payment?.Note))
                                            {
                                                <div class="text-muted small">@payment.Note</div>
                                            }
                                        </td>
                                        <td>@(payment?.PaymentDate.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                        <td class="text-end fw-bold text-success">
                                            @alloc.AllocatedAmount.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        Chưa có khoản thu nào được phân bổ cho hóa đơn này.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Quét mã VietQR nhanh cho hóa đơn này -->
@if (_showInvoiceQrModal && _invoice != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" @onclick="() => _showInvoiceQrModal = false">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-qr-code-scan me-2"></i>Mã VietQR Thanh toán Hóa đơn @_invoice.InvoiceNumber
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showInvoiceQrModal = false"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Quét mã bằng app ngân hàng để <strong>tự động điền số tiền nợ @_remainingBalance.ToString("N0") đ</strong> và nội dung thanh toán.
                    </div>

                    <div class="p-3 bg-white rounded-3 shadow-sm d-inline-block border">
                        <img src="@GetInvoiceVietQrUrl()" alt="VietQR Hóa đơn" class="img-fluid" style="max-height: 320px; object-fit: contain;" />
                    </div>

                    <div class="mt-3 text-start bg-light p-3 rounded border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Khách hàng:</span>
                            <span class="fw-semibold">@_customer?.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Ngân hàng thụ hưởng:</span>
                            <span class="fw-semibold">@_bankSettings.BankName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Số tài khoản:</span>
                            <span class="fw-bold text-primary font-monospace">@_bankSettings.AccountNumber</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Chủ tài khoản:</span>
                            <span class="fw-semibold">@_bankSettings.AccountName</span>
                        </div>
                        <div class="d-flex justify-content-between pt-2 border-top">
                            <span class="text-muted small">Số tiền cần thanh toán:</span>
                            <span class="fw-bold text-success fs-5 tabular-nums">@_remainingBalance.ToString("N0") VNĐ</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <a href="payments/create?customerId=@_invoice.CustomerId&amount=@_remainingBalance&invoiceId=@_invoice.Id" class="btn btn-success">
                        <i class="bi bi-cash-coin me-1"></i> Vào trang Ghi nhận thu tiền
                    </a>
                    <button type="button" class="btn btn-secondary" @onclick="() => _showInvoiceQrModal = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private Invoice? _invoice;
    private Customer? _customer;
    private List<InvoiceLine> _lines = new();
    private List<Product> _products = new();
    private List<PaymentAllocation> _allocations = new();
    private List<Payment> _payments = new();

    private decimal _totalPaid = 0;
    private decimal _remainingBalance = 0;
    private bool _showInvoiceQrModal = false;
    private BankSettings _bankSettings = new();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _bankSettings = await BankSettingsService.GetSettingsAsync();
            _invoice = await ViewInvoicesUseCase.GetByIdAsync(Id);
            if (_invoice != null)
            {
                _customer = await ViewCustomerByIdUseCase.ExecuteAsync(_invoice.CustomerId);
                _lines = (await ViewInvoicesUseCase.GetLinesAsync(Id)).ToList();
                _products = (await ViewProductsUseCase.ExecuteAsync()).ToList();

                // Lấy tất cả phân bổ của khách hàng này để lọc ra các phân bổ thuộc InvoiceId
                var customerAllocations = await ViewPaymentsUseCase.GetAllocationsByCustomerAsync(_invoice.CustomerId);
                _allocations = customerAllocations.Where(a => a.InvoiceId == Id).ToList();
                _payments = (await ViewPaymentsUseCase.GetPaymentsByCustomerAsync(_invoice.CustomerId)).ToList();

                _totalPaid = _allocations.Sum(a => a.AllocatedAmount);
                _remainingBalance = Math.Max(0, _invoice.TotalAmount - _totalPaid);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenInvoiceQrModal()
    {
        _showInvoiceQrModal = true;
    }

    private string GetInvoiceVietQrUrl()
    {
        if (_invoice == null) return string.Empty;
        return BankSettingsService.GenerateVietQrUrl(
            _bankSettings,
            _remainingBalance,
            _invoice.InvoiceNumber,
            _customer?.Code);
    }
}

