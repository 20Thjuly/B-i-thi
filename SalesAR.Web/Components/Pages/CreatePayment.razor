@page "/payments/create"
@attribute [Authorize(Roles = "ADMIN,ACCOUNTANT")]
@inject IRecordPaymentUseCase RecordPaymentUseCase
@inject IAllocatePaymentUseCase AllocatePaymentUseCase
@inject IViewCustomersUseCase ViewCustomersUseCase
@inject IGetCustomerDebtUseCase GetCustomerDebtUseCase
@inject IViewInvoicesUseCase ViewInvoicesUseCase
@inject IBankSettingsService BankSettingsService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Ghi nhận Thu tiền &amp; Phân bổ FIFO</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-cash-coin text-success me-2"></i>Ghi nhận Thu tiền Khách hàng
            </h1>
            <p class="text-muted small mb-0">Thực hiện thu tiền (tiền mặt / chuyển khoản VietQR) và tự động phân bổ cấn trừ công nợ theo nguyên tắc FIFO</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenBankSettings">
                <i class="bi bi-bank me-1"></i> Cài đặt TK nhận tiền
            </button>
            <a href="payments" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Toast / Notification bar -->
    @if (!string.IsNullOrEmpty(_toastMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm py-2 px-3 mb-3 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@_toastMessage</div>
            <button type="button" class="btn-close ms-auto py-2" @onclick='() => _toastMessage = null'></button>
        </div>
    }

    <!-- Friendly Business Error Alert (K3.3) -->
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div>
                <strong>Cảnh báo nghiệp vụ:</strong> @_errorMessage
            </div>
        </div>
    }

    <!-- Result Box: Hiển thị kết quả FIFO sau khi ghi nhận thành công (Yêu cầu Mục 6) -->
    @if (_isRecordedSuccess && _lastRecordedAllocations != null)
    {
        <div class="card shadow border-success mb-4">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title fw-bold mb-0">
                    <i class="bi bi-check-circle-fill me-2"></i>Ghi nhận Thu tiền Thành công!
                </h5>
            </div>
            <div class="card-body">
                <div class="p-3 bg-light rounded mb-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <span class="text-muted small">Mã phiếu thu:</span>
                            <div class="fw-bold fs-6">@_model.PaymentNumber</div>
                        </div>
                        <div class="col-12 col-md-3">
                            <span class="text-muted small">Khách hàng:</span>
                            <div class="fw-bold fs-6">@_selectedCustomer?.Name</div>
                        </div>
                        <div class="col-12 col-md-3">
                            <span class="text-muted small">Hình thức thu tiền:</span>
                            <div>
                                @if (_model.PaymentMethod == "BankTransfer")
                                {
                                    <span class="badge bg-primary fs-6">
                                        <i class="bi bi-qr-code me-1"></i> Chuyển khoản (VietQR)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success fs-6">
                                        <i class="bi bi-cash-stack me-1"></i> Tiền mặt
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <span class="text-muted small">Tổng số tiền đã thu:</span>
                            <div class="fw-bold text-success fs-5">@_model.Amount.ToString("N0") đ</div>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-diagram-3 me-2 text-primary"></i>Kết quả phân bổ công nợ theo nguyên tắc FIFO (Hóa đơn cũ nhất trước):
                </h6>

                <div class="table-responsive mb-3">
                    <table class="table table-hover align-middle border">
                        <thead class="table-light">
                            <tr>
                                <th>Hóa đơn</th>
                                <th>Ngày lập HĐ</th>
                                <th class="text-end">Nợ trước thu</th>
                                <th class="text-end">Số tiền cấn trừ (FIFO)</th>
                                <th class="text-end">Nợ còn lại</th>
                                <th class="text-center">Trạng thái sau cấn trừ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in _fifoResults)
                            {
                                <tr>
                                    <td>
                                        <a href="invoices/@res.InvoiceId" class="fw-bold text-decoration-none">
                                            @res.InvoiceNumber
                                        </a>
                                    </td>
                                    <td>@res.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@res.OriginalDebt.ToString("N0") đ</td>
                                    <td class="text-end fw-bold @(res.AllocatedAmount > 0 ? "text-success" : "text-muted")">
                                        @res.InvoiceNumber &rarr; @res.AllocatedAmount.ToString("N0") đ
                                    </td>
                                    <td class="text-end fw-semibold @(res.RemainingDebt > 0 ? "text-danger" : "text-muted")">
                                        @res.RemainingDebt.ToString("N0") đ
                                    </td>
                                    <td class="text-center">
                                        @if (res.RemainingDebt == 0)
                                        {
                                            <span class="badge bg-success">Đã tất toán</span>
                                        }
                                        else if (res.AllocatedAmount > 0)
                                        {
                                            <span class="badge bg-warning text-dark">Thanh toán 1 phần</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Chưa thanh toán</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng phân bổ thực tế:</td>
                                <td class="text-end fw-bold text-success fs-6">
                                    @_fifoResults.Sum(r => r.AllocatedAmount).ToString("N0") đ
                                </td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" @onclick="ResetForm">
                        <i class="bi bi-plus-circle me-1"></i> Thu tiền tiếp
                    </button>
                    <a href="payments" class="btn btn-outline-secondary">
                        <i class="bi bi-list me-1"></i> Về danh sách phiếu thu
                    </a>
                    @if (_selectedCustomer != null)
                    {
                        <a href="customers/@_selectedCustomer.Id" class="btn btn-outline-info">
                            <i class="bi bi-person me-1"></i> Xem chi tiết khách hàng
                        </a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row g-4">
                <!-- Form Inputs -->
                <div class="col-12 col-lg-7">
                    <!-- Phương thức thanh toán (Tiền mặt / Chuyển khoản) -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3 border-0">
                            <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
                                <i class="bi bi-wallet2 text-primary me-2"></i>
                                <span>Hình thức thu tiền</span>
                                <span class="badge bg-primary-subtle text-primary border ms-2 small">Chọn hình thức</span>
                            </h5>
                        </div>
                        <div class="card-body pt-0">
                            <div class="row g-3">
                                <!-- Thẻ chọn Tiền mặt -->
                                <div class="col-12 col-sm-6">
                                    <div class="p-3 rounded-3 border cursor-pointer transition-all @(_model.PaymentMethod == "Cash" ? "border-success bg-success-subtle shadow-sm" : "border-secondary-subtle bg-light")"
                                         style="cursor: pointer; border-width: 2px !important;"
                                         @onclick='() => SetPaymentMethod("Cash")'>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 @(_model.PaymentMethod == "Cash" ? "bg-success text-white" : "bg-white text-success border")"
                                                 style="width: 48px; height: 48px; min-width: 48px;">
                                                <i class="bi bi-cash-stack fs-4"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold text-dark fs-6">Tiền mặt</span>
                                                    @if (_model.PaymentMethod == "Cash")
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                    }
                                                </div>
                                                <div class="text-muted small">Thu tiền mặt trực tiếp tại quầy</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Thẻ chọn Chuyển khoản VietQR -->
                                <div class="col-12 col-sm-6">
                                    <div class="p-3 rounded-3 border cursor-pointer transition-all @(_model.PaymentMethod == "BankTransfer" ? "border-primary bg-primary-subtle shadow-sm" : "border-secondary-subtle bg-light")"
                                         style="cursor: pointer; border-width: 2px !important;"
                                         @onclick='() => SetPaymentMethod("BankTransfer")'>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 @(_model.PaymentMethod == "BankTransfer" ? "bg-primary text-white" : "bg-white text-primary border")"
                                                 style="width: 48px; height: 48px; min-width: 48px;">
                                                <i class="bi bi-qr-code-scan fs-4"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold text-dark fs-6">Chuyển khoản (VietQR)</span>
                                                    @if (_model.PaymentMethod == "BankTransfer")
                                                    {
                                                        <i class="bi bi-check-circle-fill text-primary fs-5"></i>
                                                    }
                                                </div>
                                                <div class="text-muted small">Quét mã QR tự động hiện số tiền</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Khung thông tin Phiếu thu cơ bản -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3 border-0">
                            <h5 class="card-title fw-bold text-dark mb-0">
                                <i class="bi bi-card-text text-primary me-2"></i>Thông tin Giao dịch Thu tiền
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Khách hàng -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Khách hàng thanh toán <span class="text-danger">*</span></label>
                                    <CustomerSelector SelectedCustomerId="@_model.CustomerId" 
                                                      SelectedCustomerIdChanged="OnCustomerSelected" />
                                    <ValidationMessage For="() => _model.CustomerId" class="text-danger small" />
                                </div>

                                <!-- Số phiếu thu -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold">Số phiếu thu <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="_model.PaymentNumber" placeholder="VD: PT-001" />
                                    <ValidationMessage For="() => _model.PaymentNumber" class="text-danger small" />
                                </div>

                                <!-- Ngày thu tiền -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold">Ngày thu tiền <span class="text-danger">*</span></label>
                                    <InputDate class="form-control" @bind-Value="_model.PaymentDate" />
                                    <ValidationMessage For="() => _model.PaymentDate" class="text-danger small" />
                                </div>

                                <!-- Số tiền thu -->
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label fw-semibold mb-0">
                                            Số tiền thu (VNĐ) <span class="text-danger">*</span>
                                        </label>
                                        @if (_totalOutstandingDebt > 0)
                                        {
                                            <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none fw-semibold"
                                                    @onclick="SelectFullDebt">
                                                <i class="bi bi-arrow-down-circle me-1"></i>Thu toàn bộ nợ (@_totalOutstandingDebt.ToString("N0") đ)
                                            </button>
                                        }
                                    </div>
                                    <div class="input-group">
                                        <InputNumber class="form-control fs-5 fw-bold text-success" 
                                                     @bind-Value="_model.Amount" 
                                                     @bind-Value:after="OnAmountChanged" 
                                                     placeholder="Nhập số tiền..." />
                                        <span class="input-group-text fw-bold">VNĐ</span>
                                    </div>
                                    <ValidationMessage For="() => _model.Amount" class="text-danger small" />

                                    <!-- Quick Amount Buttons -->
                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                        <span class="text-muted small me-1 align-self-center">Gợi ý nhanh:</span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="() => SetQuickAmount(500000)">500k</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="() => SetQuickAmount(1000000)">1 Triệu</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="() => SetQuickAmount(2000000)">2 Triệu</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="() => SetQuickAmount(5000000)">5 Triệu</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="() => SetQuickAmount(10000000)">10 Triệu</button>
                                        @if (_totalOutstandingDebt > 0)
                                        {
                                            <button type="button" class="btn btn-outline-success btn-sm py-0 px-2 fw-semibold" @onclick="SelectFullDebt">Tất toán nợ</button>
                                        }
                                    </div>

                                    @if (_selectedCustomer != null && _model.Amount > _totalOutstandingDebt && _totalOutstandingDebt > 0)
                                    {
                                        <div class="text-warning small mt-2 d-flex align-items-center">
                                            <i class="bi bi-info-circle me-1"></i>
                                            <span>Số tiền thu lớn hơn tổng công nợ hiện tại (@_totalOutstandingDebt.ToString("N0") đ). Phần dư sẽ không phân bổ cho hóa đơn nào.</span>
                                        </div>
                                    }
                                </div>

                                <!-- Giao diện chi tiết khi chọn Chuyển khoản (VietQR) -->
                                @if (_model.PaymentMethod == "BankTransfer")
                                {
                                    <div class="col-12">
                                        <div class="card border border-primary-subtle bg-white shadow-sm rounded-3 overflow-hidden">
                                            <div class="card-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-qr-code-scan fs-5"></i>
                                                    <span class="fw-bold">Mã QR Chuyển khoản VietQR (Tự động kèm số tiền)</span>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-light py-0 px-2 fw-semibold" @onclick="OpenBankSettings">
                                                    <i class="bi bi-gear-fill me-1 text-primary"></i> Đổi tài khoản nhận tiền
                                                </button>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="row g-3 align-items-center">
                                                    <!-- QR Image Box -->
                                                    <div class="col-12 col-md-5 text-center">
                                                        <div class="p-2 border rounded-3 bg-light d-inline-block position-relative shadow-sm" style="max-width: 250px;">
                                                            @if (_model.Amount > 0)
                                                            {
                                                                <img src="@GetVietQrUrl()" 
                                                                     alt="VietQR Code" 
                                                                     class="img-fluid rounded" 
                                                                     style="max-height: 230px; object-fit: contain;" />
                                                                
                                                                <div class="mt-2 d-flex justify-content-center gap-1">
                                                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => _showQrZoomModal = true" title="Phóng to">
                                                                        <i class="bi bi-zoom-in me-1"></i> Phóng to
                                                                    </button>
                                                                    <a href="@GetVietQrUrl()" target="_blank" download="vietqr_@(_model.PaymentNumber).png" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Tải ảnh">
                                                                        <i class="bi bi-download me-1"></i> Tải về
                                                                    </a>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="py-5 px-3 text-muted">
                                                                    <i class="bi bi-qr-code fs-1 d-block mb-2 text-secondary"></i>
                                                                    <small class="fw-semibold">Vui lòng nhập số tiền để tạo mã QR tự động điền số tiền!</small>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="small text-success fw-bold mt-2">
                                                            <i class="bi bi-shield-check me-1"></i>Chuẩn VietQR (NAPAS 247)
                                                        </div>
                                                    </div>

                                                    <!-- Bank & Transfer Details with Copy buttons -->
                                                    <div class="col-12 col-md-7">
                                                        <div class="p-3 bg-light rounded-3 border">
                                                            <div class="mb-2 pb-2 border-bottom">
                                                                <span class="text-muted small d-block">Ngân hàng thụ hưởng:</span>
                                                                <span class="fw-bold text-dark fs-6">@_bankSettings.BankName</span>
                                                            </div>
                                                            <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="text-muted small d-block">Số tài khoản:</span>
                                                                    <span class="fw-bold text-primary fs-6 font-monospace">@_bankSettings.AccountNumber</span>
                                                                </div>
                                                                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2" @onclick='() => CopyToClipboard(_bankSettings.AccountNumber, "Đã sao chép Số tài khoản!")'>
                                                                    <i class="bi bi-clipboard me-1"></i> Sao chép
                                                                </button>
                                                            </div>
                                                            <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="text-muted small d-block">Chủ tài khoản:</span>
                                                                    <span class="fw-bold text-dark text-uppercase">@_bankSettings.AccountName</span>
                                                                </div>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" @onclick='() => CopyToClipboard(_bankSettings.AccountName, "Đã sao chép Tên chủ TK!")'>
                                                                    <i class="bi bi-clipboard me-1"></i> Sao chép
                                                                </button>
                                                            </div>
                                                            <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="text-muted small d-block">Số tiền chuyển (Sau quét QR tự nhận diện):</span>
                                                                    <span class="fw-bold text-success fs-5 tabular-nums">@_model.Amount.ToString("N0") VNĐ</span>
                                                                </div>
                                                                <button type="button" class="btn btn-sm btn-outline-success py-1 px-2" @onclick='() => CopyToClipboard(((long)_model.Amount).ToString(), "Đã sao chép Số tiền!")'>
                                                                    <i class="bi bi-clipboard me-1"></i> Sao chép
                                                                </button>
                                                            </div>
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="text-muted small d-block">Nội dung chuyển khoản:</span>
                                                                    <span class="fw-bold text-dark font-monospace">@GetTransferDescription()</span>
                                                                </div>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" @onclick='() => CopyToClipboard(GetTransferDescription(), "Đã sao chép Nội dung CK!")'>
                                                                    <i class="bi bi-clipboard me-1"></i> Sao chép
                                                                </button>
                                                            </div>
                                                        </div>

                                                        <div class="alert alert-info py-2 px-3 small mt-2 mb-0 d-flex align-items-center gap-2">
                                                            <i class="bi bi-info-circle-fill text-info fs-6"></i>
                                                            <span>Khách hàng mở ứng dụng ngân hàng quét mã &rarr; Số tiền và nội dung được điền tự động 100%.</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Mã tham chiếu giao dịch (tùy chọn) -->
                                                <div class="mt-3 pt-2 border-top">
                                                    <label class="form-label small fw-semibold text-muted">Mã tham chiếu / Mã giao dịch ngân hàng (Tùy chọn đối soát)</label>
                                                    <InputText class="form-control form-control-sm" @bind-Value="_model.ReferenceCode" placeholder="VD: FT242948293, MB123456..." />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- Hướng dẫn khi chọn Tiền mặt -->
                                    <div class="col-12">
                                        <div class="alert alert-success d-flex align-items-center py-3 mb-0">
                                            <i class="bi bi-cash-stack fs-3 me-3 text-success"></i>
                                            <div>
                                                <h6 class="fw-bold mb-1">Thu tiền mặt trực tiếp tại quầy / quỹ</h6>
                                                <p class="small mb-0 text-muted">
                                                    Thủ quỹ kiểm đếm thực nhận đủ <strong class="text-success">@_model.Amount.ToString("N0") VNĐ</strong> từ khách hàng trước khi bấm xác nhận.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Ghi chú -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Ghi chú phiếu thu</label>
                                    <InputTextArea class="form-control" @bind-Value="_model.Note" rows="2" 
                                                   placeholder="Nhập ghi chú thêm cho giao dịch thu tiền..." />
                                    <ValidationMessage For="() => _model.Note" class="text-danger small" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Preview Phân bổ FIFO -->
                <div class="col-12 col-lg-5">
                    <div class="card shadow-sm border-0 mb-4 sticky-top" style="top: 1rem; z-index: 10;">
                        <div class="card-header bg-light py-3 border-0">
                            <h5 class="card-title fw-bold text-dark mb-0">
                                <i class="bi bi-clock-history text-primary me-2"></i>Dự kiến phân bổ FIFO
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (_selectedCustomer == null)
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-person-x fs-2 d-block mb-2 text-secondary"></i>
                                    Vui lòng chọn khách hàng để xem danh sách hóa đơn còn nợ và phân bổ FIFO.
                                </div>
                            }
                            else if (_outstandingInvoices.Count == 0)
                            {
                                <div class="alert alert-info py-3 mb-0">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Khách hàng <strong>@_selectedCustomer.Name</strong> hiện không có hóa đơn nào còn nợ!
                                </div>
                            }
                            else
                            {
                                <div class="mb-3 pb-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted small">Tổng công nợ cần thu:</span>
                                        <span class="fw-bold text-danger tabular-nums">@_totalOutstandingDebt.ToString("N0") đ</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted small">Số tiền đang thu:</span>
                                        <span class="fw-bold text-success fs-6 tabular-nums">@_model.Amount.ToString("N0") đ</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">Hình thức:</span>
                                        <span class="fw-semibold @(_model.PaymentMethod == "BankTransfer" ? "text-primary" : "text-success")">
                                            @(_model.PaymentMethod == "BankTransfer" ? "🏦 Chuyển khoản VietQR" : "💵 Tiền mặt")
                                        </span>
                                    </div>
                                </div>

                                <div class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center gap-2" style="font-size: 0.775rem;">
                                    <i class="bi bi-info-circle-fill text-info fs-6"></i>
                                    <span><strong>Nguyên tắc FIFO:</strong> Tiền thu tự động cấn trừ hóa đơn cũ nhất trước.</span>
                                </div>

                                <h6 class="fw-bold small text-muted text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">Thứ tự cấn trừ dự kiến (Cũ &rarr; Mới):</h6>
                                <div class="table-responsive mb-3" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="small table-light sticky-top">
                                            <tr>
                                                <th>Số HĐ</th>
                                                <th class="text-end">Dư nợ</th>
                                                <th class="text-end">Cấn trừ</th>
                                            </tr>
                                        </thead>
                                        <tbody class="small">
                                            @foreach (var prev in _previewAllocations)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="fw-semibold text-dark">@prev.InvoiceNumber</span>
                                                        <div class="text-muted" style="font-size: 0.72rem;">@prev.InvoiceDate.ToString("dd/MM/yyyy")</div>
                                                    </td>
                                                    <td class="text-end text-muted tabular-nums">@prev.RemainingAmount.ToString("N0") đ</td>
                                                    <td class="text-end fw-bold tabular-nums @(prev.AllocatedAmount > 0 ? "text-success" : "text-muted")">
                                                        @prev.AllocatedAmount.ToString("N0") đ
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <!-- Action button -->
                            <div class="d-grid gap-2 pt-2">
                                <button type="submit" class="btn btn-success btn-lg shadow-sm" 
                                        disabled="@(_isSubmitting || _model.CustomerId <= 0 || _model.Amount <= 0 || _outstandingInvoices.Count == 0)">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Đang xử lý phân bổ...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle me-1"></i>
                                        <span>Xác nhận Thu tiền &amp; Phân bổ</span>
                                    }
                                </button>
                                <a href="payments" class="btn btn-outline-secondary">Hủy bỏ</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

<!-- Modal: Cài đặt Thông tin Ngân hàng Nhận tiền (Bank Settings) -->
@if (_showBankSettingsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-bank me-2"></i>Cài đặt Tài khoản Ngân hàng Nhận tiền (VietQR)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showBankSettingsModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Thiết lập thông tin tài khoản ngân hàng của bạn để hệ thống tự động sinh mã VietQR chuẩn NAPAS 247 kèm số tiền khi thu tiền từ khách hàng.
                    </p>

                    <div class="row g-3">
                        <!-- Chọn Ngân hàng -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Ngân hàng thụ hưởng <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="_tempBankSettings.BankId" @bind:after="OnBankSelectionChanged">
                                @foreach (var bank in BankSettings.SupportedBanks)
                                {
                                    <option value="@bank.BankId">[@bank.BankId] @bank.ShortName - @bank.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Số tài khoản -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Số tài khoản nhận tiền <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace fw-bold" 
                                   @bind="_tempBankSettings.AccountNumber" 
                                   placeholder="Nhập số tài khoản ngân hàng của bạn..." />
                        </div>

                        <!-- Tên chủ tài khoản -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Tên chủ tài khoản (Không dấu) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control text-uppercase fw-semibold" 
                                   @bind="_tempBankSettings.AccountName" 
                                   placeholder="VD: NGUYEN VAN A hoặc CONG TY TNHH..." />
                        </div>

                        <!-- Mẫu hiển thị QR -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Giao diện khung VietQR</label>
                            <select class="form-select" @bind="_tempBankSettings.Template">
                                <option value="compact2">Chuẩn VietQR đầy đủ (Kèm logo ngân hàng &amp; NAPAS)</option>
                                <option value="compact">Chuẩn gọn (Compact)</option>
                                <option value="qr_only">Chỉ mã QR (QR Only)</option>
                            </select>
                        </div>

                        <!-- Xem trước QR -->
                        <div class="col-12 text-center pt-3 border-top">
                            <span class="text-muted small d-block mb-2">Xem trước mã QR mẫu với thông tin trên:</span>
                            <div class="p-2 border rounded bg-light d-inline-block shadow-sm">
                                <img src="@GetPreviewQrUrl()" alt="QR Preview" style="max-height: 180px; object-fit: contain;" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showBankSettingsModal = false">Đóng</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveBankSettings">
                        <i class="bi bi-save me-1"></i> Lưu thông tin tài khoản
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Phóng to mã QR để quét dễ dàng -->
@if (_showQrZoomModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" @onclick="() => _showQrZoomModal = false">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-qr-code me-2"></i>Quét mã VietQR Chuyển khoản
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showQrZoomModal = false"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="p-3 bg-white rounded-3 shadow-sm d-inline-block border">
                        <img src="@GetVietQrUrl()" alt="VietQR Zoom" class="img-fluid" style="max-height: 380px; object-fit: contain;" />
                    </div>
                    <div class="mt-3">
                        <h4 class="text-success fw-bold mb-1">@_model.Amount.ToString("N0") VNĐ</h4>
                        <div class="text-muted small">@_bankSettings.BankName - STK: @_bankSettings.AccountNumber</div>
                        <div class="text-muted small fw-semibold">Người nhận: @_bankSettings.AccountName</div>
                        <div class="badge bg-light text-dark border mt-2">Nội dung: @GetTransferDescription()</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <a href="@GetVietQrUrl()" target="_blank" download="vietqr_@(_model.PaymentNumber).png" class="btn btn-outline-primary">
                        <i class="bi bi-download me-1"></i> Tải ảnh QR
                    </a>
                    <button type="button" class="btn btn-secondary" @onclick="() => _showQrZoomModal = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int? CustomerId { get; set; }

    [SupplyParameterFromQuery]
    public decimal? Amount { get; set; }

    [SupplyParameterFromQuery]
    public int? InvoiceId { get; set; }

    [SupplyParameterFromQuery]
    public string? Method { get; set; }

    private PaymentFormModel _model = new();
    private Customer? _selectedCustomer;
    private List<InvoiceOutstandingDto> _outstandingInvoices = new();
    private List<PreviewAllocationItem> _previewAllocations = new();
    private decimal _totalOutstandingDebt = 0;

    private bool _isSubmitting = false;
    private bool _isRecordedSuccess = false;
    private List<PaymentAllocation>? _lastRecordedAllocations;
    private List<FifoResultItem> _fifoResults = new();
    private string? _errorMessage;
    private string? _toastMessage;

    // Bank settings & QR state
    private BankSettings _bankSettings = new();
    private BankSettings _tempBankSettings = new();
    private bool _showBankSettingsModal = false;
    private bool _showQrZoomModal = false;

    protected override async Task OnInitializedAsync()
    {
        _bankSettings = await BankSettingsService.GetSettingsAsync();

        if (!string.IsNullOrWhiteSpace(Method))
        {
            _model.PaymentMethod = Method.Equals("Cash", StringComparison.OrdinalIgnoreCase) ? "Cash" : "BankTransfer";
        }

        if (CustomerId.HasValue && CustomerId.Value > 0)
        {
            await OnCustomerSelected(CustomerId.Value);

            if (Amount.HasValue && Amount.Value > 0)
            {
                _model.Amount = Amount.Value;
                CalculatePreview();
            }
        }
    }

    private void SetPaymentMethod(string method)
    {
        _model.PaymentMethod = method;
    }

    private async Task OnCustomerSelected(int customerId)
    {
        _model.CustomerId = customerId;
        _errorMessage = null;

        if (customerId > 0)
        {
            var customers = await ViewCustomersUseCase.ExecuteAsync();
            _selectedCustomer = customers.FirstOrDefault(c => c.Id == customerId);

            if (_selectedCustomer != null)
            {
                var outstanding = await ViewInvoicesUseCase.GetOutstandingInvoicesByCustomerAsync(customerId);
                _outstandingInvoices = outstanding.OrderBy(i => i.InvoiceDate).ThenBy(i => i.Id).ToList();
                _totalOutstandingDebt = _outstandingInvoices.Sum(i => i.RemainingAmount);
                
                // Nếu chưa có số tiền và có nợ, mặc định điền toàn bộ nợ
                if (_model.Amount <= 0 && _totalOutstandingDebt > 0)
                {
                    _model.Amount = _totalOutstandingDebt;
                }

                CalculatePreview();
            }
        }
        else
        {
            _selectedCustomer = null;
            _outstandingInvoices.Clear();
            _previewAllocations.Clear();
            _totalOutstandingDebt = 0;
        }
    }

    private void SelectFullDebt()
    {
        if (_totalOutstandingDebt > 0)
        {
            _model.Amount = _totalOutstandingDebt;
            CalculatePreview();
        }
    }

    private void SetQuickAmount(decimal amount)
    {
        _model.Amount = amount;
        CalculatePreview();
    }

    private void OnAmountChanged()
    {
        CalculatePreview();
    }

    private void CalculatePreview()
    {
        _previewAllocations.Clear();
        if (_outstandingInvoices.Count == 0 || _model.Amount <= 0)
        {
            foreach (var inv in _outstandingInvoices)
            {
                _previewAllocations.Add(new PreviewAllocationItem
                {
                    InvoiceId = inv.Id,
                    InvoiceNumber = inv.InvoiceNumber,
                    InvoiceDate = inv.InvoiceDate,
                    RemainingAmount = inv.RemainingAmount,
                    AllocatedAmount = 0
                });
            }
            return;
        }

        // Chạy thuật toán phân bổ FIFO qua IAllocatePaymentUseCase
        var allocs = AllocatePaymentUseCase.Execute(0, _model.Amount, _outstandingInvoices);
        var allocMap = allocs.ToDictionary(a => a.InvoiceId, a => a.AllocatedAmount);

        foreach (var inv in _outstandingInvoices)
        {
            decimal alloc = allocMap.ContainsKey(inv.Id) ? allocMap[inv.Id] : 0;
            _previewAllocations.Add(new PreviewAllocationItem
            {
                InvoiceId = inv.Id,
                InvoiceNumber = inv.InvoiceNumber,
                InvoiceDate = inv.InvoiceDate,
                RemainingAmount = inv.RemainingAmount,
                AllocatedAmount = alloc
            });
        }
    }

    private string GetVietQrUrl()
    {
        return BankSettingsService.GenerateVietQrUrl(
            _bankSettings,
            _model.Amount,
            _model.PaymentNumber,
            _selectedCustomer?.Code);
    }

    private string GetPreviewQrUrl()
    {
        return BankSettingsService.GenerateVietQrUrl(
            _tempBankSettings,
            1000000,
            "MAU-001",
            "KHACHHANG");
    }

    private string GetTransferDescription()
    {
        string desc = $"TT {_model.PaymentNumber}";
        if (_selectedCustomer != null && !string.IsNullOrWhiteSpace(_selectedCustomer.Code))
        {
            desc += $" {_selectedCustomer.Code}";
        }
        return desc;
    }

    private async Task CopyToClipboard(string text, string successMessage)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _toastMessage = successMessage;
        }
        catch
        {
            _toastMessage = $"Đã copy: {text}";
        }
    }

    private void OpenBankSettings()
    {
        _tempBankSettings = new BankSettings
        {
            BankId = _bankSettings.BankId,
            BankName = _bankSettings.BankName,
            AccountNumber = _bankSettings.AccountNumber,
            AccountName = _bankSettings.AccountName,
            Template = _bankSettings.Template
        };
        _showBankSettingsModal = true;
    }

    private void OnBankSelectionChanged()
    {
        var found = BankSettings.SupportedBanks.FirstOrDefault(b => b.BankId == _tempBankSettings.BankId);
        if (found != null)
        {
            _tempBankSettings.BankName = $"{found.ShortName} ({found.Name})";
        }
    }

    private async Task SaveBankSettings()
    {
        if (string.IsNullOrWhiteSpace(_tempBankSettings.AccountNumber))
        {
            _errorMessage = "Vui lòng nhập số tài khoản ngân hàng.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_tempBankSettings.AccountName))
        {
            _errorMessage = "Vui lòng nhập tên chủ tài khoản.";
            return;
        }

        await BankSettingsService.SaveSettingsAsync(_tempBankSettings);
        _bankSettings = _tempBankSettings;
        _showBankSettingsModal = false;
        _toastMessage = "Đã cập nhật thông tin tài khoản ngân hàng thành công!";
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        if (_model.Amount <= 0)
        {
            _errorMessage = "Số tiền thanh toán phải lớn hơn 0.";
            return;
        }

        if (_model.CustomerId <= 0)
        {
            _errorMessage = "Vui lòng chọn khách hàng cần thu tiền.";
            return;
        }

        if (_outstandingInvoices.Count == 0)
        {
            _errorMessage = "Khách hàng hiện không có hóa đơn nào còn nợ để thanh toán.";
            return;
        }

        _isSubmitting = true;
        try
        {
            // Ghi nhận phương thức thanh toán vào Note
            string methodPrefix = _model.PaymentMethod == "BankTransfer" 
                ? $"[Chuyển khoản VietQR - {_bankSettings.BankId} {_bankSettings.AccountNumber}]" 
                : "[Tiền mặt]";

            string finalNote = methodPrefix;
            if (!string.IsNullOrWhiteSpace(_model.ReferenceCode))
            {
                finalNote += $" [Mã GD: {_model.ReferenceCode.Trim()}]";
            }
            if (!string.IsNullOrWhiteSpace(_model.Note))
            {
                finalNote += $" {_model.Note.Trim()}";
            }

            var payment = new Payment
            {
                CustomerId = _model.CustomerId,
                PaymentNumber = _model.PaymentNumber,
                PaymentDate = _model.PaymentDate,
                Amount = _model.Amount,
                Note = finalNote
            };

            // Thực hiện ghi nhận và phân bổ FIFO thông qua RecordPaymentUseCase
            int paymentId = await RecordPaymentUseCase.ExecuteAsync(payment);

            // Thu thập kết quả phân bổ thực tế để hiển thị
            var allocations = AllocatePaymentUseCase.Execute(paymentId, payment.Amount, _outstandingInvoices);
            _lastRecordedAllocations = allocations;
            var allocMap = allocations.ToDictionary(a => a.InvoiceId, a => a.AllocatedAmount);

            _fifoResults.Clear();
            foreach (var inv in _outstandingInvoices)
            {
                decimal alloc = allocMap.ContainsKey(inv.Id) ? allocMap[inv.Id] : 0;
                _fifoResults.Add(new FifoResultItem
                {
                    InvoiceId = inv.Id,
                    InvoiceNumber = inv.InvoiceNumber,
                    InvoiceDate = inv.InvoiceDate,
                    OriginalDebt = inv.RemainingAmount,
                    AllocatedAmount = alloc,
                    RemainingDebt = Math.Max(0, inv.RemainingAmount - alloc)
                });
            }

            _isRecordedSuccess = true;
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = "Đã xảy ra lỗi trong quá trình ghi nhận phiếu thu. Vui lòng kiểm tra lại.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _isRecordedSuccess = false;
        _lastRecordedAllocations = null;
        _fifoResults.Clear();
        _model = new PaymentFormModel();
        _selectedCustomer = null;
        _outstandingInvoices.Clear();
        _previewAllocations.Clear();
        _totalOutstandingDebt = 0;
        _errorMessage = null;
        _toastMessage = null;
    }

    private class PreviewAllocationItem
    {
        public int InvoiceId { get; set; }
        public string InvoiceNumber { get; set; } = string.Empty;
        public DateTime InvoiceDate { get; set; }
        public decimal RemainingAmount { get; set; }
        public decimal AllocatedAmount { get; set; }
    }

    private class FifoResultItem
    {
        public int InvoiceId { get; set; }
        public string InvoiceNumber { get; set; } = string.Empty;
        public DateTime InvoiceDate { get; set; }
        public decimal OriginalDebt { get; set; }
        public decimal AllocatedAmount { get; set; }
        public decimal RemainingDebt { get; set; }
    }
}
