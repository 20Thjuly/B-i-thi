@page "/payments"
@attribute [Authorize(Roles = "ADMIN,ACCOUNTANT")]
@inject IViewPaymentsUseCase ViewPaymentsUseCase
@inject IViewCustomersUseCase ViewCustomersUseCase
@inject IPaymentRepository PaymentRepository

<PageTitle>Danh sách Phiếu thu Tiền</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-cash-stack text-success me-2"></i>Danh sách Phiếu thu Tiền
            </h1>
            <p class="text-muted small mb-0">Quản lý các đợt thu tiền từ khách hàng và phân bổ công nợ FIFO</p>
        </div>
        <a href="payments/create" class="btn btn-success d-inline-flex align-items-center">
            <i class="bi bi-plus-circle me-1"></i> Ghi nhận Thu tiền mới
        </a>
    </div>

    <!-- Filter toolbar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm theo số phiếu thu, ghi chú..." 
                               @bind="_searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <select class="form-select" @bind="_filterCustomerId">
                        <option value="0">-- Tất cả khách hàng --</option>
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Id">[@c.Code] @c.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (_loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Số phiếu thu</th>
                                <th>Khách hàng</th>
                                <th>Ngày thu tiền</th>
                                <th class="text-end">Số tiền thu (VNĐ)</th>
                                <th>Ghi chú</th>
                                <th class="text-center">Số HĐ phân bổ</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredPayments.Any())
                            {
                                @foreach (var p in FilteredPayments)
                                {
                                    var cust = _customers.FirstOrDefault(c => c.Id == p.CustomerId);
                                    var allocCount = _allocationsMap.ContainsKey(p.Id) ? _allocationsMap[p.Id].Count : 0;
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark">@p.PaymentNumber</span>
                                        </td>
                                        <td>
                                            @if (cust != null)
                                            {
                                                <a href="customers/@cust.Id" class="text-decoration-none fw-semibold">
                                                    [@cust.Code] @cust.Name
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Mã: @p.CustomerId</span>
                                            }
                                        </td>
                                        <td>@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end fw-bold text-success fs-6">
                                            @p.Amount.ToString("N0") đ
                                        </td>
                                        <td class="text-muted">@(string.IsNullOrWhiteSpace(p.Note) ? "-" : p.Note)</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-diagram-3 me-1"></i>@allocCount HĐ
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-info" @onclick="() => ShowAllocationsModal(p)">
                                                <i class="bi bi-eye me-1"></i>Xem phân bổ
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        Không tìm thấy phiếu thu nào phù hợp.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal xem chi tiết phân bổ FIFO -->
@if (_selectedPayment != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-diagram-3-fill me-2"></i>Chi tiết phân bổ FIFO - @_selectedPayment.PaymentNumber
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3 bg-light p-3 rounded">
                        <div class="col-6">
                            <span class="text-muted small">Khách hàng:</span>
                            <div class="fw-bold">@(_customers.FirstOrDefault(c => c.Id == _selectedPayment.CustomerId)?.Name ?? "N/A")</div>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted small">Tổng tiền thu:</span>
                            <div class="fw-bold text-success fs-5">@_selectedPayment.Amount.ToString("N0") đ</div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-2">Các hóa đơn được cấn trừ theo thứ tự ngày lập (FIFO):</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã phân bổ</th>
                                    <th>Mã Hóa đơn</th>
                                    <th class="text-end">Số tiền cấn trừ (VNĐ)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_currentAllocations.Any())
                                {
                                    @foreach (var a in _currentAllocations)
                                    {
                                        <tr>
                                            <td>#@a.Id</td>
                                            <td>
                                                <a href="invoices/@a.InvoiceId" class="fw-bold text-decoration-none">
                                                    Hóa đơn #@a.InvoiceId
                                                </a>
                                            </td>
                                            <td class="text-end fw-bold text-primary">@a.AllocatedAmount.ToString("N0") đ</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-3 text-muted">Không có thông tin phân bổ chi tiết.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="2" class="text-end fw-bold">Tổng tiền phân bổ:</td>
                                    <td class="text-end fw-bold text-success">@_currentAllocations.Sum(a => a.AllocatedAmount).ToString("N0") đ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<Payment> _payments = new();
    private List<Customer> _customers = new();
    private Dictionary<int, List<PaymentAllocation>> _allocationsMap = new();

    private string _searchTerm = "";
    private int _filterCustomerId = 0;

    private Payment? _selectedPayment;
    private List<PaymentAllocation> _currentAllocations = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _payments = (await ViewPaymentsUseCase.ExecuteAsync()).OrderByDescending(p => p.PaymentDate).ToList();
            _customers = (await ViewCustomersUseCase.ExecuteAsync()).ToList();

            foreach (var p in _payments)
            {
                var allocs = (await ViewPaymentsUseCase.GetAllocationsAsync(p.Id)).ToList();
                _allocationsMap[p.Id] = allocs;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<Payment> FilteredPayments => _payments.Where(p =>
    {
        bool matchSearch = string.IsNullOrWhiteSpace(_searchTerm) ||
                           p.PaymentNumber.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           (!string.IsNullOrEmpty(p.Note) && p.Note.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

        bool matchCustomer = _filterCustomerId == 0 || p.CustomerId == _filterCustomerId;

        return matchSearch && matchCustomer;
    });

    private void ShowAllocationsModal(Payment payment)
    {
        _selectedPayment = payment;
        _currentAllocations = _allocationsMap.ContainsKey(payment.Id) ? _allocationsMap[payment.Id] : new();
    }

    private void CloseModal()
    {
        _selectedPayment = null;
        _currentAllocations = new();
    }
}
