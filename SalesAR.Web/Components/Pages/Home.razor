@page "/"
@page "/dashboard"
@inject IGetAgingReportUseCase GetAgingReportUseCase
@inject IViewInvoicesUseCase ViewInvoicesUseCase
@inject IViewCustomersUseCase ViewCustomersUseCase

<PageTitle>Dashboard - Bán hàng & Công nợ</PageTitle>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Tổng quan Công nợ (Dashboard)
            </h1>
            <p class="text-muted small mb-0">Hệ thống Quản lý Bán hàng & Công nợ Khách hàng (Sales & AR)</p>
        </div>
        <div class="d-flex gap-2">
            <a href="invoices/create" class="btn btn-primary d-inline-flex align-items-center">
                <i class="bi bi-plus-circle me-1"></i> Lập hóa đơn mới
            </a>
            <a href="payments/create" class="btn btn-success d-inline-flex align-items-center">
                <i class="bi bi-cash-stack me-1"></i> Thu tiền (FIFO)
            </a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted small">Đang tải dữ liệu từ CSDL...</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>Lỗi kết nối dữ liệu:</strong> @_errorMessage
            </div>
        </div>
    }
    else
    {
        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <DebtSummaryCard Title="Tổng công nợ" 
                                  Amount="@_totalDebt" 
                                  Icon="bi-wallet2" 
                                  Subtitle="Toàn bộ dư nợ chưa thu" />
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <DebtSummaryCard Title="Tổng tiền quá hạn" 
                                  Amount="@_overdueDebt" 
                                  Icon="bi-exclamation-octagon-fill" 
                                  CardClass="border-start border-danger border-4" 
                                  Subtitle="Quá hạn thanh toán > 30 ngày" />
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100 rounded-3">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Khách hàng đang nợ</span>
                            <div class="rounded-circle p-2 bg-light text-warning">
                                <i class="bi bi-people-fill fs-5"></i>
                            </div>
                        </div>
                        <div class="fs-4 fs-md-3 fw-bold mb-1">
                            @_indebtedCustomersCount <span class="fs-6 fw-normal text-muted">khách hàng</span>
                        </div>
                        <div class="small text-muted">Trên tổng @_totalCustomersCount khách hàng</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100 rounded-3">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Hóa đơn chưa thu</span>
                            <div class="rounded-circle p-2 bg-light text-danger">
                                <i class="bi bi-receipt fs-5"></i>
                            </div>
                        </div>
                        <div class="fs-4 fs-md-3 fw-bold mb-1">
                            @_unpaidInvoicesCount <span class="fs-6 fw-normal text-muted">hóa đơn</span>
                        </div>
                        <div class="small text-muted">Cần theo dõi và phân bổ</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4 Nhóm tuổi nợ (Aging Buckets) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-semibold text-dark">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i>Phân bổ Tuổi nợ (Aging Groups)
                </h5>
                <a href="aging-report" class="small text-decoration-none">Xem báo cáo chi tiết &rarr;</a>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row g-3 text-center">
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="small text-muted fw-semibold">0–30 NGÀY</div>
                            <div class="fs-5 fw-bold text-dark mt-1">@_bucket0To30.ToString("N0") đ</div>
                            <div class="small text-success">Trong hạn / Mới phát sinh</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="small text-muted fw-semibold">31–60 NGÀY</div>
                            <div class="fs-5 fw-bold text-warning-emphasis mt-1">@_bucket31To60.ToString("N0") đ</div>
                            <div class="small text-warning">Cần nhắc nợ đợt 1</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="small text-muted fw-semibold">61–90 NGÀY</div>
                            <div class="fs-5 fw-bold text-danger mt-1">@_bucket61To90.ToString("N0") đ</div>
                            <div class="small text-danger">Quá hạn mức trung</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 bg-danger-subtle border border-danger-subtle">
                            <div class="small text-danger fw-bold">> 90 NGÀY</div>
                            <div class="fs-5 fw-bold text-danger mt-1">@_bucketOver90.ToString("N0") đ</div>
                            <div class="small text-danger fw-semibold">Nợ khó đòi / Khẩn cấp</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top khách hàng công nợ cao & Hóa đơn gần đây -->
        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-semibold text-dark">
                            <i class="bi bi-trophy-fill text-warning me-2"></i>Top Khách hàng Công nợ cao nhất
                        </h5>
                        <a href="customers" class="small text-decoration-none">Tất cả khách hàng &rarr;</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Khách hàng</th>
                                        <th class="text-end">Hạn mức</th>
                                        <th class="text-end">Hiện đang nợ</th>
                                        <th class="text-center">Tỷ lệ nợ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_topDebtCustomers != null && _topDebtCustomers.Any())
                                    {
                                        @foreach (var c in _topDebtCustomers)
                                        {
                                            var percent = c.CreditLimit > 0 ? (int)Math.Min(100, (c.TotalDebt / c.CreditLimit * 100)) : 0;
                                            var barColor = percent >= 90 ? "bg-danger" : (percent >= 70 ? "bg-warning" : "bg-primary");
                                            <tr>
                                                <td>
                                                    <a href="customers/@c.CustomerId" class="fw-bold text-dark text-decoration-none">
                                                        [@c.CustomerCode] @c.CustomerName
                                                    </a>
                                                </td>
                                                <td class="text-end">@c.CreditLimit.ToString("N0") đ</td>
                                                <td class="text-end fw-bold text-danger">@c.TotalDebt.ToString("N0") đ</td>
                                                <td class="text-center" style="min-width: 120px;">
                                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                                        <div class="progress flex-grow-1" style="height: 6px;">
                                                            <div class="progress-bar @barColor" style="width: @percent%"></div>
                                                        </div>
                                                        <span class="small fw-semibold text-muted">@percent%</span>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-3">Không có công nợ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-semibold text-dark">
                            <i class="bi bi-clock-history text-secondary me-2"></i>Hóa đơn chưa thanh toán gần đây
                        </h5>
                        <a href="invoices" class="small text-decoration-none">Tất cả hóa đơn &rarr;</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Số HĐ</th>
                                        <th class="text-end">Số tiền</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_recentUnpaidInvoices != null && _recentUnpaidInvoices.Any())
                                    {
                                        @foreach (var inv in _recentUnpaidInvoices)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="invoices/@inv.Id" class="fw-bold text-dark text-decoration-none">
                                                        @inv.InvoiceNumber
                                                    </a>
                                                    <div class="small text-muted">@inv.InvoiceDate.ToString("dd/MM/yyyy")</div>
                                                </td>
                                                <td class="text-end fw-semibold">
                                                    @inv.TotalAmount.ToString("N0") đ
                                                </td>
                                                <td class="text-center">
                                                    <InvoiceStatusBadge Status="@inv.Status" />
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-3">Tất cả hóa đơn đã được thanh toán!</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private string? _errorMessage;

    private decimal _totalDebt;
    private decimal _overdueDebt;
    private int _indebtedCustomersCount;
    private int _totalCustomersCount;
    private int _unpaidInvoicesCount;

    private decimal _bucket0To30;
    private decimal _bucket31To60;
    private decimal _bucket61To90;
    private decimal _bucketOver90;

    private IEnumerable<AgingReportItem>? _topDebtCustomers;
    private IEnumerable<Invoice>? _recentUnpaidInvoices;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var agingSummary = await GetAgingReportUseCase.ExecuteAsync(DateTime.Now);
            var allInvoices = await ViewInvoicesUseCase.ExecuteAsync();
            var allCustomers = await ViewCustomersUseCase.ExecuteAsync();

            _totalDebt = agingSummary.TotalDebt;
            _bucket0To30 = agingSummary.Total0To30;
            _bucket31To60 = agingSummary.Total31To60;
            _bucket61To90 = agingSummary.Total61To90;
            _bucketOver90 = agingSummary.TotalOver90;
            _overdueDebt = _bucket31To60 + _bucket61To90 + _bucketOver90;

            _totalCustomersCount = allCustomers.Count();
            _indebtedCustomersCount = agingSummary.Items.Count(i => i.TotalDebt > 0);

            var unpaid = allInvoices.Where(i => i.Status != "Paid" && i.Status != "Cancelled").ToList();
            _unpaidInvoicesCount = unpaid.Count;
            _recentUnpaidInvoices = unpaid.Take(5);

            _topDebtCustomers = agingSummary.Items
                .Where(i => i.TotalDebt > 0)
                .OrderByDescending(i => i.TotalDebt)
                .Take(5);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
