@page "/"
@page "/dashboard"
@attribute [Authorize]
@inject IGetAgingReportUseCase GetAgingReportUseCase
@inject IViewInvoicesUseCase ViewInvoicesUseCase
@inject IViewCustomersUseCase ViewCustomersUseCase

<PageTitle>Dashboard - Bán hàng & Công nợ</PageTitle>

<div class="container-fluid px-0">
    <!-- Hero Welcome Banner -->
    <div class="welcome-hero mb-4">
        <div class="row align-items-center g-3 position-relative" style="z-index: 2;">
            <div class="col-12 col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 text-white-50 small mb-2 border border-white border-opacity-10">
                    <span class="spinner-grow spinner-grow-sm text-success" style="width: 6px; height: 6px;" role="status"></span>
                    <span>Hệ thống trực tuyến • Dữ liệu đồng bộ thời gian thực</span>
                </div>
                <h1 class="h3 fw-bold text-white mb-2">
                    Tổng quan Bán hàng &amp; Công nợ Khách hàng
                </h1>
                <p class="text-white text-opacity-75 mb-0 small" style="max-width: 600px;">
                    Theo dõi sát sao hạn mức tín dụng, dòng tiền thanh toán FIFO và tiến độ thu hồi nợ xấu để tối ưu hóa nguồn vốn lưu động.
                </p>
            </div>
            <div class="col-12 col-lg-4 text-lg-end">
                <div class="d-flex gap-2 justify-content-lg-end flex-wrap">
                    <a href="invoices/create" class="btn btn-light d-inline-flex align-items-center text-primary fw-semibold shadow-sm">
                        <i class="bi bi-plus-circle-fill text-primary me-1"></i> Lập hóa đơn
                    </a>
                    <a href="payments/create" class="btn btn-success d-inline-flex align-items-center shadow-sm">
                        <i class="bi bi-cash-stack me-1"></i> Thu tiền FIFO
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="card border-0 shadow-sm py-5 text-center my-4">
            <div class="spinner-border text-primary mx-auto mb-3" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
            <div class="fw-semibold text-dark">Đang tổng hợp dữ liệu thời gian thực...</div>
            <div class="small text-muted mt-1">Đang đối soát công nợ & phân tích tuổi nợ từ CSDL SQL Server</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
            <div>
                <strong class="d-block mb-1">Lỗi kết nối hoặc xử lý dữ liệu:</strong>
                <span>@_errorMessage</span>
            </div>
        </div>
    }
    else
    {
        <!-- 4 KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <DebtSummaryCard Title="Tổng công nợ" 
                                  Amount="@_totalDebt" 
                                  Icon="bi-wallet2" 
                                  Subtitle="Toàn bộ dư nợ chưa thu" />
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <DebtSummaryCard Title="Nợ quá hạn (>30 ngày)" 
                                  Amount="@_overdueDebt" 
                                  Icon="bi-exclamation-octagon-fill" 
                                  CardClass="border-start border-danger border-4" 
                                  Subtitle="Cần ưu tiên nhắc nợ và thu hồi" />
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card h-100 card-hover-lift">
                    <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.04em;">Khách hàng đang nợ</span>
                                <div class="d-flex align-items-center justify-content-center rounded-3 bg-light text-warning border" style="width: 38px; height: 38px;">
                                    <i class="bi bi-people-fill fs-5"></i>
                                </div>
                            </div>
                            <div class="fs-4 fs-md-3 fw-bold text-dark mb-1 tabular-nums">
                                @_indebtedCustomersCount <span class="fs-6 fw-normal text-muted">/ @_totalCustomersCount KH</span>
                            </div>
                        </div>
                        <div class="small text-muted mt-2 d-flex align-items-center gap-1" style="font-size: 0.775rem;">
                            <i class="bi bi-pie-chart text-muted"></i>
                            <span>Tỷ lệ có dư nợ: @(_totalCustomersCount > 0 ? (_indebtedCustomersCount * 100 / _totalCustomersCount) : 0)%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card h-100 card-hover-lift">
                    <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.04em;">Hóa đơn chưa thu</span>
                                <div class="d-flex align-items-center justify-content-center rounded-3 bg-light text-danger border" style="width: 38px; height: 38px;">
                                    <i class="bi bi-receipt fs-5"></i>
                                </div>
                            </div>
                            <div class="fs-4 fs-md-3 fw-bold text-dark mb-1 tabular-nums">
                                @_unpaidInvoicesCount <span class="fs-6 fw-normal text-muted">chứng từ</span>
                            </div>
                        </div>
                        <div class="small text-muted mt-2 d-flex align-items-center gap-1" style="font-size: 0.775rem;">
                            <i class="bi bi-arrow-right-circle text-muted"></i>
                            <span>Sẵn sàng cho phân bổ FIFO</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4 Nhóm tuổi nợ (Aging Buckets) -->
        <div class="card mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="p-2 rounded-3 bg-primary-subtle text-primary">
                        <i class="bi bi-pie-chart-fill"></i>
                    </span>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark" style="font-size: 0.95rem;">
                            Phân bổ Tuổi nợ Hiện tại (Aging Buckets)
                        </h5>
                        <span class="text-muted small" style="font-size: 0.75rem;">Phân loại rủi ro theo số ngày quá hạn thanh toán</span>
                    </div>
                </div>
                <a href="aging-report" class="btn btn-outline-primary btn-sm">
                    Xem báo cáo đầy đủ <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">
                    <!-- 0 - 30 ngày -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 rounded-3 border h-100 bg-white" style="border-top: 3px solid #10b981 !important;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted fw-bold">0–30 NGÀY</span>
                                <span class="badge badge-soft-success">Trong hạn</span>
                            </div>
                            <div class="fs-5 fw-bold text-dark my-1 tabular-nums">
                                @_bucket0To30.ToString("N0") <span class="small fw-normal text-muted">đ</span>
                            </div>
                            <div class="small text-muted" style="font-size: 0.75rem;">
                                @(_totalDebt > 0 ? (_bucket0To30 / _totalDebt * 100).ToString("N1") : "0")% tổng dư nợ
                            </div>
                        </div>
                    </div>

                    <!-- 31 - 60 ngày -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 rounded-3 border h-100 bg-white" style="border-top: 3px solid #f59e0b !important;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted fw-bold">31–60 NGÀY</span>
                                <span class="badge badge-soft-warning">Nhắc nợ đợt 1</span>
                            </div>
                            <div class="fs-5 fw-bold text-dark my-1 tabular-nums">
                                @_bucket31To60.ToString("N0") <span class="small fw-normal text-muted">đ</span>
                            </div>
                            <div class="small text-muted" style="font-size: 0.75rem;">
                                @(_totalDebt > 0 ? (_bucket31To60 / _totalDebt * 100).ToString("N1") : "0")% tổng dư nợ
                            </div>
                        </div>
                    </div>

                    <!-- 61 - 90 ngày -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 rounded-3 border h-100 bg-white" style="border-top: 3px solid #f97316 !important;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted fw-bold">61–90 NGÀY</span>
                                <span class="badge badge-soft-warning">Quá hạn mức 2</span>
                            </div>
                            <div class="fs-5 fw-bold text-dark my-1 tabular-nums">
                                @_bucket61To90.ToString("N0") <span class="small fw-normal text-muted">đ</span>
                            </div>
                            <div class="small text-muted" style="font-size: 0.75rem;">
                                @(_totalDebt > 0 ? (_bucket61To90 / _totalDebt * 100).ToString("N1") : "0")% tổng dư nợ
                            </div>
                        </div>
                    </div>

                    <!-- > 90 ngày -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 rounded-3 border h-100 bg-white" style="border-top: 3px solid #f43f5e !important;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-danger fw-bold">&gt; 90 NGÀY</span>
                                <span class="badge badge-soft-danger">Nợ khó đòi</span>
                            </div>
                            <div class="fs-5 fw-bold text-danger my-1 tabular-nums">
                                @_bucketOver90.ToString("N0") <span class="small fw-normal text-muted">đ</span>
                            </div>
                            <div class="small text-muted" style="font-size: 0.75rem;">
                                @(_totalDebt > 0 ? (_bucketOver90 / _totalDebt * 100).ToString("N1") : "0")% tổng dư nợ (Cần xử lý)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top khách hàng công nợ cao & Hóa đơn gần đây -->
        <div class="row g-4">
            <!-- Top Khách hàng -->
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="p-2 rounded-3 bg-warning-subtle text-warning">
                                <i class="bi bi-trophy-fill"></i>
                            </span>
                            <h5 class="card-title mb-0 fw-bold text-dark" style="font-size: 0.95rem;">
                                Top Khách hàng Dư nợ lớn nhất
                            </h5>
                        </div>
                        <a href="customers" class="btn btn-outline-secondary btn-sm">
                            Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive border-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Khách hàng</th>
                                        <th class="text-end">Hạn mức</th>
                                        <th class="text-end">Hiện đang nợ</th>
                                        <th class="text-center" style="width: 140px;">Tỷ lệ sử dụng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_topDebtCustomers != null && _topDebtCustomers.Any())
                                    {
                                        var rank = 1;
                                        @foreach (var c in _topDebtCustomers)
                                        {
                                            var percent = c.CreditLimit > 0 ? (int)Math.Min(100, (c.TotalDebt / c.CreditLimit * 100)) : 0;
                                            var barColor = percent >= 90 ? "bg-danger" : (percent >= 70 ? "bg-warning" : "bg-primary");
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge rounded-circle p-1 d-flex align-items-center justify-content-center @(rank == 1 ? "bg-warning text-dark" : (rank == 2 ? "bg-secondary text-white" : "bg-light text-muted border"))" 
                                                              style="width: 22px; height: 22px; font-size: 0.7rem;">
                                                            @rank
                                                        </span>
                                                        <div>
                                                            <a href="customers/@c.CustomerId" class="fw-bold text-dark text-decoration-none d-block" style="font-size: 0.85rem;">
                                                                @c.CustomerName
                                                            </a>
                                                            <span class="small text-muted" style="font-size: 0.75rem;">[@c.CustomerCode]</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-end text-muted tabular-nums">@c.CreditLimit.ToString("N0") đ</td>
                                                <td class="text-end fw-bold text-danger tabular-nums">@c.TotalDebt.ToString("N0") đ</td>
                                                <td class="text-center">
                                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                                        <div class="credit-bar-wrapper flex-grow-1" style="height: 6px;">
                                                            <div class="credit-bar-fill @barColor" style="width: @percent%"></div>
                                                        </div>
                                                        <span class="small fw-bold text-muted tabular-nums" style="font-size: 0.75rem;">@percent%</span>
                                                    </div>
                                                </td>
                                            </tr>
                                            rank++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="bi bi-check-circle text-success me-1"></i>Không có khách hàng nào đang nợ.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hóa đơn chưa thanh toán gần đây -->
            <div class="col-12 col-lg-5">
                <div class="card h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="p-2 rounded-3 bg-info-subtle text-info">
                                <i class="bi bi-clock-history"></i>
                            </span>
                            <h5 class="card-title mb-0 fw-bold text-dark" style="font-size: 0.95rem;">
                                Hóa đơn chờ thanh toán
                            </h5>
                        </div>
                        <a href="invoices" class="btn btn-outline-secondary btn-sm">
                            Tất cả HĐ <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive border-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Số HĐ</th>
                                        <th class="text-end">Số tiền</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_recentUnpaidInvoices != null && _recentUnpaidInvoices.Any())
                                    {
                                        @foreach (var inv in _recentUnpaidInvoices)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="invoices/@inv.Id" class="fw-bold text-dark text-decoration-none d-block">
                                                        @inv.InvoiceNumber
                                                    </a>
                                                    <span class="small text-muted" style="font-size: 0.75rem;">
                                                        <i class="bi bi-calendar3 me-1"></i>@inv.InvoiceDate.ToString("dd/MM/yyyy")
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold text-dark tabular-nums">
                                                    @inv.TotalAmount.ToString("N0") đ
                                                </td>
                                                <td class="text-center">
                                                    <InvoiceStatusBadge Status="@inv.Status" />
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-4">
                                                <i class="bi bi-check-circle-fill text-success fs-5 d-block mb-1"></i>
                                                <span>Tuyệt vời! Tất cả hóa đơn đã thanh toán xong.</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private string? _errorMessage;

    private decimal _totalDebt;
    private decimal _overdueDebt;
    private int _indebtedCustomersCount;
    private int _totalCustomersCount;
    private int _unpaidInvoicesCount;

    private decimal _bucket0To30;
    private decimal _bucket31To60;
    private decimal _bucket61To90;
    private decimal _bucketOver90;

    private IEnumerable<AgingReportItem>? _topDebtCustomers;
    private IEnumerable<Invoice>? _recentUnpaidInvoices;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var agingSummary = await GetAgingReportUseCase.ExecuteAsync(DateTime.Now);
            var allInvoices = await ViewInvoicesUseCase.ExecuteAsync();
            var allCustomers = await ViewCustomersUseCase.ExecuteAsync();

            _totalDebt = agingSummary.TotalDebt;
            _bucket0To30 = agingSummary.Total0To30;
            _bucket31To60 = agingSummary.Total31To60;
            _bucket61To90 = agingSummary.Total61To90;
            _bucketOver90 = agingSummary.TotalOver90;
            _overdueDebt = _bucket31To60 + _bucket61To90 + _bucketOver90;

            _totalCustomersCount = allCustomers.Count();
            _indebtedCustomersCount = agingSummary.Items.Count(i => i.TotalDebt > 0);

            var unpaid = allInvoices.Where(i => i.Status != "Paid" && i.Status != "Cancelled").ToList();
            _unpaidInvoicesCount = unpaid.Count;
            _recentUnpaidInvoices = unpaid.Take(5);

            _topDebtCustomers = agingSummary.Items
                .Where(i => i.TotalDebt > 0)
                .OrderByDescending(i => i.TotalDebt)
                .Take(5);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
