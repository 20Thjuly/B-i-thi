@page "/login"
@rendermode InteractiveServer
@inject ILoginUseCase LoginUseCase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Đăng nhập - Sales & AR</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <!-- Modern Login Card -->
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header with brand gradient -->
                <div class="card-header text-center py-4 text-white" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%);">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" 
                         style="width: 48px; height: 48px; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px);">
                        <i class="bi bi-shield-lock-fill fs-3 text-white"></i>
                    </div>
                    <h3 class="fw-bold mb-1 fs-4" style="letter-spacing: -0.01em;">Đăng nhập SalesAR</h3>
                    <p class="small text-white-50 mb-0">Hệ thống Quản lý Bán hàng &amp; Công nợ Khách hàng</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4 py-2" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger flex-shrink-0"></i>
                            <div>@_errorMessage</div>
                        </div>
                    }

                    <EditForm Model="@_loginModel" FormName="LoginForm" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên đăng nhập</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-person"></i>
                                </span>
                                <InputText class="form-control border-start-0 ps-1" @bind-Value="_loginModel.Username" placeholder="Nhập tên đăng nhập..." />
                            </div>
                            <ValidationMessage For="() => _loginModel.Username" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input type="password" class="form-control border-start-0 ps-1" @bind="_loginModel.Password" placeholder="Nhập mật khẩu..." />
                            </div>
                            <ValidationMessage For="() => _loginModel.Password" class="text-danger small" />
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm" disabled="@_isSubmitting">
                                @if (_isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Đang xác thực bảo mật...</span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    <span>Đăng nhập hệ thống</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <!-- Phím tắt Demo cho Giảng viên / Ban Giám Khảo kiểm thử -->
                    <div class="border-top pt-3">
                        <div class="small fw-bold text-muted text-uppercase mb-2 text-center" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            Tài khoản mẫu để kiểm thử &amp; chấm điểm:
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center p-2 rounded-3"
                                    @onclick='() => SetDemoUser("admin", "Admin@123")' title="Click để tự động điền tài khoản ADMIN">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-gear fs-5 text-danger"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.8rem;">ADMIN</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Toàn quyền hệ thống &amp; quản trị</div>
                                    </div>
                                </div>
                                <span class="badge badge-soft-danger font-monospace">admin / Admin@123</span>
                            </button>

                            <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center p-2 rounded-3"
                                    @onclick='() => SetDemoUser("sales", "Sales@123")' title="Click để tự động điền tài khoản SALES">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-cart fs-5 text-primary"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.8rem;">SALES</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Quản lý KH, Sản phẩm &amp; Lập HĐ</div>
                                    </div>
                                </div>
                                <span class="badge badge-soft-primary font-monospace">sales / Sales@123</span>
                            </button>

                            <button type="button" class="btn btn-sm btn-outline-success text-start d-flex justify-content-between align-items-center p-2 rounded-3"
                                    @onclick='() => SetDemoUser("accountant", "Acc@123")' title="Click để tự động điền tài khoản ACCOUNTANT">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calculator fs-5 text-success"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.8rem;">ACCOUNTANT</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Thu tiền (FIFO) &amp; Xuất Aging Report</div>
                                    </div>
                                </div>
                                <span class="badge badge-soft-success font-monospace">accountant / Acc@123</span>
                            </button>

                            <button type="button" class="btn btn-sm btn-outline-warning text-start d-flex justify-content-between align-items-center p-2 rounded-3"
                                    @onclick='() => SetDemoUser("creditmanager", "Credit@123")' title="Click để tự động điền tài khoản CREDIT_MANAGER">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-shield-check fs-5 text-warning"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size: 0.8rem;">CREDIT_MANAGER</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Phê duyệt hạn mức tín dụng &amp; Kiểm soát rủi ro</div>
                                    </div>
                                </div>
                                <span class="badge bg-warning-subtle text-dark font-monospace">creditmanager / Credit@123</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginViewModel _loginModel = new();
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private void SetDemoUser(string u, string p)
    {
        _loginModel.Username = u;
        _loginModel.Password = p;
        _errorMessage = null;
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var user = await LoginUseCase.ExecuteAsync(_loginModel.Username, _loginModel.Password);

            var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
            await customAuth.MarkUserAsAuthenticatedAsync(user);

            Navigation.NavigateTo("dashboard", forceLoad: false);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = "Đã xảy ra lỗi không mong muốn trong quá trình đăng nhập. Vui lòng thử lại.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class LoginViewModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Tên đăng nhập là bắt buộc.")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Mật khẩu là bắt buộc.")]
        public string Password { get; set; } = string.Empty;
    }
}
