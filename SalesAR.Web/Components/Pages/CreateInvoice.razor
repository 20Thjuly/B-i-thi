@page "/invoices/create"
@attribute [Authorize(Roles = "ADMIN,SALES")]
@inject ICreateInvoiceUseCase CreateInvoiceUseCase
@inject IViewCustomersUseCase ViewCustomersUseCase
@inject IGetCustomerDebtUseCase GetCustomerDebtUseCase
@inject IViewProductsUseCase ViewProductsUseCase
@inject NavigationManager NavManager

<PageTitle>Lập Hóa đơn Bán hàng</PageTitle>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-file-earmark-plus text-primary me-2"></i>Lập Hóa đơn Bán hàng mới
            </h1>
            <p class="text-muted small mb-0">Tạo hóa đơn bán chịu và tự động kiểm tra hạn mức tín dụng khách hàng</p>
        </div>
        <a href="invoices" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Friendly Business Error Alert (K3.3) -->
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div>
                <strong>Cảnh báo nghiệp vụ:</strong> @_errorMessage
            </div>
        </div>
    }

    <!-- Success Alert -->
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>@_successMessage</div>
        </div>
    }

    <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="row g-4">
            <!-- Left Column: Form Details & Items -->
            <div class="col-12 col-lg-8">
                <!-- Card 1: Thông tin chung -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="card-title fw-bold text-dark mb-0">
                            <i class="bi bi-info-circle text-primary me-2"></i>1. Thông tin Hóa đơn
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Khách hàng <span class="text-danger">*</span></label>
                                <CustomerSelector SelectedCustomerId="@_model.CustomerId" 
                                                  SelectedCustomerIdChanged="OnCustomerChanged" />
                                <ValidationMessage For="() => _model.CustomerId" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Số hóa đơn <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_model.InvoiceNumber" placeholder="VD: HD-001" />
                                <ValidationMessage For="() => _model.InvoiceNumber" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Ngày lập hóa đơn <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="_model.InvoiceDate" />
                                <ValidationMessage For="() => _model.InvoiceDate" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Hạn thanh toán <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="_model.DueDate" />
                                <ValidationMessage For="() => _model.DueDate" class="text-danger small" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Chi tiết hàng hóa (Invoice Lines) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h5 class="card-title fw-bold text-dark mb-0">
                            <i class="bi bi-cart-check text-primary me-2"></i>2. Chi tiết Sản phẩm bán
                        </h5>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="OpenProductMenu">
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> Thêm sản phẩm
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (_model.Lines.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <div class="rounded-circle bg-light d-inline-flex p-3 mb-3">
                                    <i class="bi bi-basket text-primary fs-1"></i>
                                </div>
                                <h6 class="fw-bold text-dark">Chưa có sản phẩm nào trong hóa đơn</h6>
                                <p class="text-muted small mb-3">Nhấn vào nút bên dưới để mở Menu danh mục sản phẩm và chọn hàng</p>
                                <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" @onclick="OpenProductMenu">
                                    <i class="bi bi-grid-3x3-gap-fill me-1"></i> Mở Menu Sản Phẩm
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="min-width: 220px;">Sản phẩm</th>
                                            <th style="width: 140px;" class="text-center">Số lượng</th>
                                            <th style="width: 170px;" class="text-end">Đơn giá (VNĐ)</th>
                                            <th style="width: 170px;" class="text-end">Thành tiền</th>
                                            <th style="width: 50px;" class="text-center"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < _model.Lines.Count; i++)
                                        {
                                            var idx = i;
                                            var line = _model.Lines[idx];
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark">
                                                        @if (!string.IsNullOrEmpty(line.ProductCode))
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@line.ProductCode</span>
                                                        }
                                                        @line.ProductName
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(line.Unit))
                                                    {
                                                        <span class="text-muted small">ĐVT: @line.Unit</span>
                                                    }
                                                    @if (line.ProductId <= 0)
                                                    {
                                                        <span class="text-danger small d-block mt-1">Vui lòng chọn sản phẩm.</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="input-group input-group-sm">
                                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => DecreaseQuantity(idx)" title="Giảm 1">-</button>
                                                        <input type="number" class="form-control text-center" 
                                                               min="1" @bind="line.Quantity" @bind:event="oninput" 
                                                               @onchange="RecalculateTotals" />
                                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => IncreaseQuantity(idx)" title="Tăng 1">+</button>
                                                    </div>
                                                    @if (line.Quantity <= 0)
                                                    {
                                                        <span class="text-danger small d-block text-center mt-1">SL &gt; 0</span>
                                                    }
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm text-end" 
                                                           min="0" step="1000" @bind="line.UnitPrice" @bind:event="oninput" 
                                                           @onchange="RecalculateTotals" />
                                                    @if (line.UnitPrice < 0)
                                                    {
                                                        <span class="text-danger small d-block text-end mt-1">Giá &ge; 0</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold text-dark">
                                                    @line.Amount.ToString("N0") đ
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1" 
                                                            title="Xóa dòng" @onclick="() => RemoveLine(idx)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold">Tổng tiền hàng:</td>
                                            <td class="text-end fw-bold text-primary fs-6">
                                                @_model.TotalAmount.ToString("N0") đ
                                            </td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Credit Limit Check & Actions -->
            <div class="col-12 col-lg-4">
                <!-- Card 3: Kiểm tra Hạn mức Tín dụng (Business Rule 1 - K1.3 / K3.3) -->
                <div class="card shadow-sm border-0 mb-4 @(_isOverLimit ? "border-danger border-2" : "")">
                    <div class="card-header @(_isOverLimit ? "bg-danger text-white" : "bg-light") py-3 border-0">
                        <h5 class="card-title fw-bold mb-0 @(_isOverLimit ? "text-white" : "text-dark")">
                            <i class="bi bi-shield-check me-2"></i>Kiểm soát Hạn mức Tín dụng
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (_selectedCustomer == null)
                        {
                            <div class="text-muted text-center py-4">
                                <i class="bi bi-person-badge fs-2 d-block mb-2 text-secondary"></i>
                                Vui lòng chọn khách hàng để kiểm tra hạn mức và công nợ hiện tại.
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 pb-3 border-bottom">
                                <span class="text-muted small d-block">Khách hàng được chọn:</span>
                                <span class="fw-bold fs-6 text-dark">@_selectedCustomer.Name</span>
                                <div class="text-muted small">Mã: @_selectedCustomer.Code | ĐT: @_selectedCustomer.Phone</div>
                            </div>

                            <!-- Visual Credit Health Progress Bar -->
                            <div class="mb-3 p-2.5 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold text-muted" style="font-size: 0.75rem;">Sử dụng hạn mức:</span>
                                    <span class="small fw-bold tabular-nums @(_isOverLimit ? "text-danger" : "text-dark")" style="font-size: 0.75rem;">
                                        @GetUsagePercent()% @(_isOverLimit ? "(Vượt trần!)" : "")
                                    </span>
                                </div>
                                <div class="credit-bar-wrapper" style="height: 8px;">
                                    <div class="credit-bar-fill @GetBarColor()" style="width: @(GetUsagePercent())%"></div>
                                </div>
                                <div class="d-flex justify-content-between small text-muted mt-1" style="font-size: 0.7rem;">
                                    <span>Đã nợ: @_currentDebt.ToString("N0") đ</span>
                                    <span>Trần: @_selectedCustomer.CreditLimit.ToString("N0") đ</span>
                                </div>
                            </div>

                            <ul class="list-unstyled mb-3">
                                <li class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Hạn mức tín dụng:</span>
                                    <span class="fw-bold text-dark tabular-nums">@_selectedCustomer.CreditLimit.ToString("N0") đ</span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Công nợ hiện tại:</span>
                                    <span class="fw-bold text-warning tabular-nums">@_currentDebt.ToString("N0") đ</span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Hạn mức còn lại:</span>
                                    <span class="fw-bold tabular-nums @(_remainingCredit < 0 ? "text-danger" : "text-success")">
                                        @_remainingCredit.ToString("N0") đ
                                    </span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center mb-2 pt-2 border-top">
                                    <span class="fw-semibold small">Tổng HĐ mới:</span>
                                    <span class="fw-bold text-primary fs-6 tabular-nums">+@_model.TotalAmount.ToString("N0") đ</span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center mb-2 pt-2 border-top">
                                    <span class="fw-bold small">Nợ sau khi tạo HĐ:</span>
                                    <span class="fw-bold fs-5 tabular-nums @(_isOverLimit ? "text-danger" : "text-primary")">
                                        @((_currentDebt + _model.TotalAmount).ToString("N0")) đ
                                    </span>
                                </li>
                            </ul>

                            <!-- Overlimit Warning Box (Yêu cầu chính xác của đề bài) -->
                            @if (_isOverLimit)
                            {
                                <div class="alert alert-danger py-2 px-3 small mb-3">
                                    <i class="bi bi-x-octagon-fill me-1"></i>
                                    <strong>Không thể bán chịu: công nợ sau khi tạo hóa đơn sẽ vượt hạn mức tín dụng.</strong>
                                    <div class="mt-1 text-muted" style="font-size: 0.8rem;">
                                        Vượt: +@((_currentDebt + _model.TotalAmount - _selectedCustomer.CreditLimit).ToString("N0")) đ
                                    </div>
                                </div>
                            }
                            else if (_model.TotalAmount > 0)
                            {
                                <div class="alert alert-success py-2 px-3 small mb-3">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Đủ điều kiện bán chịu. Hạn mức còn lại sau HĐ: 
                                    <strong>@((_remainingCredit - _model.TotalAmount).ToString("N0")) đ</strong>
                                </div>
                            }
                        }

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg" 
                                    disabled="@(_isSubmitting || _isOverLimit || _model.CustomerId <= 0 || _model.Lines.Count == 0)">
                                @if (_isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Đang tạo hóa đơn...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>Hoàn tất &amp; Tạo Hóa Đơn</span>
                                }
                            </button>

                            <a href="invoices" class="btn btn-outline-secondary">Hủy bỏ</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

<!-- Modal Menu Danh mục Sản phẩm (Product Catalog Picker) -->
@if (_showProductMenu)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">Menu Sản Phẩm Bán Hàng</h5>
                            <span class="text-muted small">Chọn sản phẩm từ danh mục kho để thêm vào hóa đơn</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseProductMenu"></button>
                </div>

                <div class="modal-body p-4 bg-light">
                    <!-- Search input -->
                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" 
                               placeholder="Tìm nhanh theo mã (SP001...) hoặc tên sản phẩm..." 
                               @bind="_productSearchTerm" @bind:event="oninput" autofocus />
                        @if (!string.IsNullOrWhiteSpace(_productSearchTerm))
                        {
                            <button class="btn btn-outline-secondary border-start-0 bg-white" type="button" @onclick="() => _productSearchTerm = string.Empty">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>

                    <!-- Filter count -->
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                        <span class="small text-muted">
                            Hiển thị <strong>@FilteredProducts.Count()</strong> sản phẩm khả dụng
                        </span>
                        @if (_model.Lines.Count > 0)
                        {
                            <span class="badge bg-primary-subtle text-primary">
                                Đã thêm: @_model.Lines.Count mặt hàng
                            </span>
                        }
                    </div>

                    <!-- Product Table -->
                    <div class="card border-0 shadow-sm overflow-hidden">
                        <div class="table-responsive" style="max-height: 380px;">
                            <table class="table table-hover align-middle mb-0 bg-white">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="min-width: 240px;">Sản phẩm</th>
                                        <th style="width: 140px;" class="text-center">Tồn kho</th>
                                        <th style="width: 140px;" class="text-end">Đơn giá</th>
                                        <th style="width: 160px;" class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!FilteredProducts.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                <i class="bi bi-search display-6 d-block mb-2 text-secondary"></i>
                                                Không tìm thấy sản phẩm nào khớp với từ khóa "@_productSearchTerm"
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var prod in FilteredProducts)
                                        {
                                            var inCart = _model.Lines.FirstOrDefault(l => l.ProductId == prod.Id);
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@prod.Code</span>
                                                        @prod.Name
                                                    </div>
                                                    <span class="text-muted small">ĐVT: @prod.Unit</span>
                                                </td>
                                                <td class="text-center">
                                                    @if (prod.StockQuantity <= 0)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Hết hàng</span>
                                                    }
                                                    else if (prod.StockQuantity <= 10)
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Sắp hết (@prod.StockQuantity)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Còn @prod.StockQuantity @prod.Unit</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold text-dark tabular-nums">
                                                    @prod.Price.ToString("N0") đ
                                                </td>
                                                <td class="text-center">
                                                    @if (prod.StockQuantity <= 0)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-light text-muted border" disabled>
                                                            <i class="bi bi-slash-circle me-1"></i>Hết hàng
                                                        </button>
                                                    }
                                                    else if (inCart != null)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                                            <span class="badge bg-success me-1">x@inCart.Quantity</span>
                                                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => SelectProduct(prod)" title="Thêm tiếp 1">
                                                                <i class="bi bi-plus-lg"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectProduct(prod)">
                                                            <i class="bi bi-cart-plus me-1"></i>Thêm vào HĐ
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="text-muted small">Đã chọn:</span>
                        <strong class="text-dark"> @_model.Lines.Count mặt hàng</strong>
                        <span class="mx-2 text-muted">|</span>
                        <span class="text-muted small">Tạm tính:</span>
                        <strong class="text-primary fs-6 tabular-nums"> @_model.TotalAmount.ToString("N0") đ</strong>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="CloseProductMenu">
                        <i class="bi bi-check2-circle me-1"></i>Xong &amp; Xem Hóa Đơn
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private InvoiceFormModel _model = new();
    private Customer? _selectedCustomer;
    private decimal _currentDebt = 0;
    private decimal _remainingCredit = 0;
    private bool _isOverLimit = false;
    private bool _isSubmitting = false;

    private List<Product> _availableProducts = new();
    private bool _showProductMenu = false;
    private string _productSearchTerm = "";
    private string? _errorMessage;
    private string? _successMessage;

    private IEnumerable<Product> FilteredProducts => _availableProducts.Where(p => 
        string.IsNullOrWhiteSpace(_productSearchTerm) || 
        p.Name.Contains(_productSearchTerm, StringComparison.OrdinalIgnoreCase) || 
        p.Code.Contains(_productSearchTerm, StringComparison.OrdinalIgnoreCase));

    private void OpenProductMenu()
    {
        _productSearchTerm = "";
        _showProductMenu = true;
    }

    private void CloseProductMenu()
    {
        _showProductMenu = false;
        CheckCreditLimit();
    }

    private void SelectProduct(Product p)
    {
        var existing = _model.Lines.FirstOrDefault(l => l.ProductId == p.Id);
        if (existing != null)
        {
            existing.Quantity += 1;
        }
        else
        {
            _model.Lines.Add(new InvoiceLineFormModel
            {
                ProductId = p.Id,
                ProductCode = p.Code,
                ProductName = p.Name,
                Unit = p.Unit,
                UnitPrice = p.Price,
                Quantity = 1
            });
        }
        CheckCreditLimit();
    }

    private void IncreaseQuantity(int index)
    {
        if (index >= 0 && index < _model.Lines.Count)
        {
            _model.Lines[index].Quantity++;
            CheckCreditLimit();
        }
    }

    private void DecreaseQuantity(int index)
    {
        if (index >= 0 && index < _model.Lines.Count && _model.Lines[index].Quantity > 1)
        {
            _model.Lines[index].Quantity--;
            CheckCreditLimit();
        }
    }

    private int GetUsagePercent()
    {
        if (_selectedCustomer == null || _selectedCustomer.CreditLimit <= 0) return 0;
        var newTotal = _currentDebt + _model.TotalAmount;
        return (int)Math.Min(100, Math.Max(0, (newTotal / _selectedCustomer.CreditLimit * 100)));
    }

    private string GetBarColor()
    {
        if (_isOverLimit) return "bg-danger";
        return GetUsagePercent() >= 85 ? "bg-warning" : "bg-primary";
    }

    protected override async Task OnInitializedAsync()
    {
        _availableProducts = (await ViewProductsUseCase.ExecuteAsync()).Where(p => p.IsActive).ToList();
    }

    private async Task OnCustomerChanged(int customerId)
    {
        _model.CustomerId = customerId;
        _errorMessage = null;

        if (customerId > 0)
        {
            var customers = await ViewCustomersUseCase.ExecuteAsync();
            _selectedCustomer = customers.FirstOrDefault(c => c.Id == customerId);

            if (_selectedCustomer != null)
            {
                var debtDto = await GetCustomerDebtUseCase.ExecuteAsync(customerId);
                _currentDebt = debtDto?.CurrentDebt ?? 0;
                _remainingCredit = _selectedCustomer.CreditLimit - _currentDebt;
                
                // Cập nhật ngày đáo hạn tự động dựa theo PaymentTermDays của khách hàng
                _model.DueDate = _model.InvoiceDate.AddDays(_selectedCustomer.PaymentTermDays > 0 ? _selectedCustomer.PaymentTermDays : 30);
            }
        }
        else
        {
            _selectedCustomer = null;
            _currentDebt = 0;
            _remainingCredit = 0;
        }

        CheckCreditLimit();
    }

    private void AddNewLine()
    {
        OpenProductMenu();
    }

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < _model.Lines.Count)
        {
            _model.Lines.RemoveAt(index);
            CheckCreditLimit();
        }
    }

    private void OnLineProductChanged(int index, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int productId))
        {
            var line = _model.Lines[index];
            line.ProductId = productId;
            var prod = _availableProducts.FirstOrDefault(p => p.Id == productId);
            if (prod != null)
            {
                line.ProductCode = prod.Code;
                line.ProductName = prod.Name;
                line.Unit = prod.Unit;
                line.UnitPrice = prod.Price;
            }
            CheckCreditLimit();
        }
    }

    private void RecalculateTotals()
    {
        CheckCreditLimit();
    }

    private void CheckCreditLimit()
    {
        if (_selectedCustomer == null)
        {
            _isOverLimit = false;
            return;
        }

        decimal newInvoiceTotal = _model.TotalAmount;
        _remainingCredit = _selectedCustomer.CreditLimit - _currentDebt;
        _isOverLimit = (_currentDebt + newInvoiceTotal) > _selectedCustomer.CreditLimit;

        if (_isOverLimit)
        {
            _errorMessage = "Không thể bán chịu: công nợ sau khi tạo hóa đơn sẽ vượt hạn mức tín dụng.";
        }
        else if (_errorMessage == "Không thể bán chịu: công nợ sau khi tạo hóa đơn sẽ vượt hạn mức tín dụng.")
        {
            _errorMessage = null;
        }
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        _successMessage = null;

        // Kiểm tra ràng buộc dòng sản phẩm
        if (_model.Lines.Count == 0)
        {
            _errorMessage = "Hóa đơn phải có ít nhất một dòng sản phẩm chi tiết.";
            return;
        }

        if (_model.Lines.Any(l => l.ProductId <= 0))
        {
            _errorMessage = "Vui lòng chọn sản phẩm hợp lệ cho tất cả các dòng.";
            return;
        }

        if (_model.Lines.Any(l => l.Quantity <= 0))
        {
            _errorMessage = "Số lượng của mỗi sản phẩm phải lớn hơn 0.";
            return;
        }

        // Kiểm tra Business Rule 1 - Hạn mức tín dụng
        if (_selectedCustomer != null && (_currentDebt + _model.TotalAmount > _selectedCustomer.CreditLimit))
        {
            _errorMessage = "Không thể bán chịu: công nợ sau khi tạo hóa đơn sẽ vượt hạn mức tín dụng.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var invoice = new Invoice
            {
                CustomerId = _model.CustomerId,
                InvoiceNumber = _model.InvoiceNumber,
                InvoiceDate = _model.InvoiceDate,
                DueDate = _model.DueDate,
                TotalAmount = _model.TotalAmount,
                Status = "Unpaid"
            };

            var lines = _model.Lines.Select(l => new InvoiceLine
            {
                ProductId = l.ProductId,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                Amount = l.Quantity * l.UnitPrice
            }).ToList();

            int newInvoiceId = await CreateInvoiceUseCase.ExecuteAsync(invoice, lines);

            _successMessage = $"Tạo hóa đơn {invoice.InvoiceNumber} thành công!";
            await Task.Delay(1000);
            NavManager.NavigateTo($"/invoices/{newInvoiceId}");
        }
        catch (InvalidOperationException ex)
        {
            // Hiển thị thông báo nghiệp vụ thân thiện, KHÔNG hiển thị stack trace (K3.3)
            _errorMessage = ex.Message.Contains("hạn mức tín dụng")
                ? "Không thể bán chịu: công nợ sau khi tạo hóa đơn sẽ vượt hạn mức tín dụng."
                : ex.Message;
        }
        catch (Exception)
        {
            // Lỗi hệ thống ngoài dự kiến - Thông báo thân thiện (K3.3)
            _errorMessage = "Đã xảy ra lỗi trong quá trình tạo hóa đơn. Vui lòng kiểm tra lại thông tin và thử lại.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
