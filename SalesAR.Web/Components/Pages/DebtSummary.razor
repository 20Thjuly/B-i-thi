@page "/debt"
@attribute [Authorize]
@inject IViewCustomersUseCase ViewCustomersUseCase
@inject IGetCustomerDebtUseCase GetCustomerDebtUseCase
@inject IInvoiceRepository InvoiceRepository
@inject SalesAR.UseCases.AI.IDebtReminderAiService DebtReminderAiService

<PageTitle>Theo dõi Công nợ Khách hàng</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-wallet2 text-primary me-2"></i>Tổng hợp Công nợ Khách hàng
            </h1>
            <p class="text-muted small mb-0">Theo dõi chi tiết công nợ, hạn mức tín dụng và số dư khả dụng của từng khách hàng</p>
        </div>
        <div class="d-flex gap-2">
            <AuthorizeView Roles="ADMIN,SALES">
                <a href="invoices/create" class="btn btn-primary btn-sm">
                    <i class="bi bi-receipt me-1"></i> Lập hóa đơn
                </a>
            </AuthorizeView>
            <AuthorizeView Roles="ADMIN,ACCOUNTANT">
                <a href="payments/create" class="btn btn-success btn-sm">
                    <i class="bi bi-cash-coin me-1"></i> Thu tiền
                </a>
            </AuthorizeView>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <DebtSummaryCard Title="Tổng công nợ toàn hệ thống" 
                                  Amount="@_debtList.Sum(d => d.CurrentDebt)" 
                                  Icon="bi-exclamation-diamond" 
                                  CardClass="border-start border-danger border-4" 
                                  Subtitle="Tổng tiền khách hàng đang nợ" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <DebtSummaryCard Title="Tổng hạn mức đã cấp" 
                                  Amount="@_debtList.Sum(d => d.CreditLimit)" 
                                  Icon="bi-shield-check" 
                                  CardClass="border-start border-primary border-4" 
                                  Subtitle="Tổng trần tín dụng khả dụng" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <DebtSummaryCard Title="Tổng thu lũy kế" 
                                  Amount="@_debtList.Sum(d => d.TotalPaid)" 
                                  Icon="bi-cash-stack" 
                                  CardClass="border-start border-success border-4" 
                                  Subtitle="Tổng tiền đã thu về tài khoản" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold">Khách hàng đang nợ</span>
                            <i class="bi bi-people text-danger fs-4"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">@_debtList.Count(d => d.CurrentDebt > 0) / @_debtList.Count</h3>
                        <span class="text-muted small">khách hàng có số dư công nợ &gt; 0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Tìm theo mã hoặc tên khách hàng..." 
                                   @bind="_searchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6 text-md-end">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-secondary btn-sm @(_filterMode == "all" ? "active" : "")" 
                                    @onclick='() => _filterMode = "all"'>Tất cả (@_debtList.Count)</button>
                            <button type="button" class="btn btn-outline-danger btn-sm @(_filterMode == "indebted" ? "active" : "")" 
                                    @onclick='() => _filterMode = "indebted"'>Đang nợ (@_debtList.Count(d => d.CurrentDebt > 0))</button>
                            <button type="button" class="btn btn-outline-success btn-sm @(_filterMode == "clear" ? "active" : "")" 
                                    @onclick='() => _filterMode = "clear"'>Không nợ (@_debtList.Count(d => d.CurrentDebt == 0))</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Debt Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Khách hàng</th>
                                <th class="text-end">Hạn mức tín dụng</th>
                                <th class="text-end">Đã mua (Lũy kế)</th>
                                <th class="text-end">Đã trả (Lũy kế)</th>
                                <th class="text-end">Công nợ hiện tại</th>
                                <th class="text-end">Hạn mức còn lại</th>
                                <th class="text-center">Tỷ lệ sử dụng</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredList.Any())
                            {
                                @foreach (var item in FilteredList)
                                {
                                    decimal usagePercent = item.CreditLimit > 0 ? (item.CurrentDebt / item.CreditLimit) * 100 : 0;
                                    <tr>
                                        <td>
                                            <a href="customers/@item.CustomerId" class="fw-bold text-dark text-decoration-none">
                                                @item.CustomerName
                                            </a>
                                            <div class="text-muted small">Mã: @item.CustomerCode</div>
                                        </td>
                                        <td class="text-end">@item.CreditLimit.ToString("N0") đ</td>
                                        <td class="text-end text-muted">@item.TotalInvoiced.ToString("N0") đ</td>
                                        <td class="text-end text-success">@item.TotalPaid.ToString("N0") đ</td>
                                        <td class="text-end fw-bold @(item.CurrentDebt > 0 ? "text-danger" : "text-muted") fs-6">
                                            @item.CurrentDebt.ToString("N0") đ
                                        </td>
                                        <td class="text-end fw-semibold @(item.AvailableCredit < 0 ? "text-danger" : "text-primary")">
                                            @item.AvailableCredit.ToString("N0") đ
                                        </td>
                                        <td class="text-center" style="min-width: 120px;">
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar @(usagePercent > 90 ? "bg-danger" : (usagePercent > 60 ? "bg-warning" : "bg-success"))" 
                                                     role="progressbar" style="width: @(Math.Min(100, usagePercent))%"></div>
                                            </div>
                                            <span class="small text-muted" style="font-size: 0.75rem;">@usagePercent.ToString("N1")%</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                @if (item.CurrentDebt > 0)
                                                {
                                                    <button class="btn btn-sm btn-outline-info" title="Soạn email nhắc nợ bằng AI" 
                                                            @onclick="() => OpenAiModal(item)">
                                                        <i class="bi bi-robot"></i>
                                                    </button>
                                                    <AuthorizeView Roles="ADMIN,ACCOUNTANT">
                                                        <a href="payments/create?customerId=@item.CustomerId" class="btn btn-sm btn-outline-success" title="Thu tiền">
                                                            <i class="bi bi-cash"></i>
                                                        </a>
                                                    </AuthorizeView>
                                                }
                                                <a href="customers/@item.CustomerId" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        Không tìm thấy khách hàng nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td>TỔNG CỘNG:</td>
                                <td class="text-end text-primary">@FilteredList.Sum(d => d.CreditLimit).ToString("N0") đ</td>
                                <td class="text-end text-muted">@FilteredList.Sum(d => d.TotalInvoiced).ToString("N0") đ</td>
                                <td class="text-end text-success">@FilteredList.Sum(d => d.TotalPaid).ToString("N0") đ</td>
                                <td class="text-end text-danger fs-6">@FilteredList.Sum(d => d.CurrentDebt).ToString("N0") đ</td>
                                <td class="text-end text-primary">@FilteredList.Sum(d => d.AvailableCredit).ToString("N0") đ</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Trợ lý AI Soạn Thư Nhắc Nợ (K4.3: Kế toán duyệt trước, AI không tự gửi / không tự đổi dữ liệu) -->
@if (_showAiModal && _selectedDebt != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-robot me-2"></i>Trợ lý AI - Soạn Thảo Email Nhắc Nợ Khách Hàng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAiModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-light p-3 rounded flex-wrap gap-2">
                        <div>
                            <span class="text-muted small">Khách hàng:</span>
                            <div class="fw-bold fs-6">[@_selectedDebt.CustomerCode] @_selectedDebt.CustomerName</div>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small">Công nợ hiện tại:</span>
                            <div class="fw-bold text-danger fs-5">@_selectedDebt.CurrentDebt.ToString("N0") đ</div>
                        </div>
                    </div>

                    <div class="mb-3 d-flex align-items-center gap-3">
                        <label class="form-label fw-semibold mb-0 small">Giọng văn thư nhắc nợ:</label>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn @(_aiTone == "polite" ? "btn-primary" : "btn-outline-primary")" 
                                    @onclick='() => ChangeTone("polite")'>
                                Lịch sự (Định kỳ)
                            </button>
                            <button type="button" class="btn @(_aiTone == "urgent" ? "btn-danger" : "btn-outline-danger")" 
                                    @onclick='() => ChangeTone("urgent")'>
                                Khẩn cấp (Quá hạn)
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold small mb-0">Nội dung thư do AI đề xuất (Kế toán có thể chỉnh sửa trực tiếp):</label>
                            @if (_isGeneratingAi)
                            {
                                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                            }
                        </div>
                        <textarea class="form-control font-monospace small" rows="12" @bind="_aiDraftEmail"></textarea>
                    </div>

                    <!-- Cảnh báo An toàn & Quy chuẩn AI K4.3 -->
                    <div class="alert alert-info py-2 px-3 small mb-0">
                        <i class="bi bi-shield-check text-primary me-1"></i>
                        <strong>Quy chuẩn bảo mật AI (K4.3):</strong> AI chỉ hỗ trợ tạo bản thảo nội dung. Kế toán chịu trách nhiệm rà soát trước khi gửi.
                        Hệ thống <em>tuyệt đối không tự gửi email</em>, <em>không tự ghi nhận thanh toán</em> và <em>không tự thay đổi hạn mức tín dụng</em>.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAiModal">Đóng</button>
                    <button type="button" class="btn btn-success" @onclick="CopyDraft">
                        <i class="bi bi-clipboard-check me-1"></i> Sao chép nội dung
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<CustomerDebtDto> _debtList = new();
    private string _searchTerm = "";
    private string _filterMode = "all";

    // AI Modal State
    private bool _showAiModal = false;
    private CustomerDebtDto? _selectedDebt;
    private string _aiDraftEmail = string.Empty;
    private string _aiTone = "polite";
    private bool _isGeneratingAi = false;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var customers = await ViewCustomersUseCase.ExecuteAsync();
            _debtList.Clear();

            foreach (var c in customers)
            {
                var debt = await GetCustomerDebtUseCase.ExecuteAsync(c.Id);
                if (debt != null)
                {
                    _debtList.Add(debt);
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<CustomerDebtDto> FilteredList => _debtList.Where(d =>
    {
        bool matchSearch = string.IsNullOrWhiteSpace(_searchTerm) ||
                           d.CustomerName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           d.CustomerCode.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase);

        bool matchFilter = _filterMode switch
        {
            "indebted" => d.CurrentDebt > 0,
            "clear" => d.CurrentDebt == 0,
            _ => true
        };

        return matchSearch && matchFilter;
    });

    private async Task OpenAiModal(CustomerDebtDto debt)
    {
        _selectedDebt = debt;
        _showAiModal = true;
        _aiTone = "polite";
        await GenerateDraftAsync();
    }

    private void CloseAiModal()
    {
        _showAiModal = false;
        _selectedDebt = null;
        _aiDraftEmail = string.Empty;
    }

    private async Task ChangeTone(string tone)
    {
        _aiTone = tone;
        await GenerateDraftAsync();
    }

    private async Task GenerateDraftAsync()
    {
        if (_selectedDebt == null) return;
        _isGeneratingAi = true;
        try
        {
            var unpaid = await InvoiceRepository.GetOutstandingInvoicesByCustomerAsync(_selectedDebt.CustomerId);
            _aiDraftEmail = await DebtReminderAiService.DraftReminderEmailAsync(_selectedDebt, unpaid, _aiTone);
        }
        finally
        {
            _isGeneratingAi = false;
        }
    }

    private void CopyDraft()
    {
        // Copy action note
        CloseAiModal();
    }
}
