@page "/customers"
@inject IViewCustomersUseCase ViewCustomersUseCase
@inject IAddCustomerUseCase AddCustomerUseCase
@inject IEditCustomerUseCase EditCustomerUseCase
@inject IDeleteCustomerUseCase DeleteCustomerUseCase
@inject NavigationManager Navigation

<PageTitle>Quản lý Khách hàng</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Danh sách Khách hàng
            </h1>
            <p class="text-muted small mb-0">Quản lý đối tác mua hàng và hạn mức công nợ tín dụng</p>
        </div>
        <button class="btn btn-primary d-inline-flex align-items-center" @onclick="OpenAddModal">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm khách hàng mới
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@_statusMessage
            <button type="button" class="btn-close" @onclick="() => _statusMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <!-- Search box -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm theo mã, tên hoặc số điện thoại..." 
                               @bind="_searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select class="form-select" @bind="_filterStatus">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="active">Đang hoạt động</option>
                        <option value="inactive">Ngừng hoạt động</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (_loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã KH</th>
                                <th>Tên khách hàng</th>
                                <th>Số điện thoại</th>
                                <th>Địa chỉ</th>
                                <th class="text-end">Hạn mức tín dụng</th>
                                <th class="text-center">Hạn TT</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredCustomers.Any())
                            {
                                @foreach (var c in FilteredCustomers)
                                {
                                    <tr>
                                        <td class="fw-bold">@c.Code</td>
                                        <td>
                                            <a href="customers/@c.Id" class="fw-semibold text-primary text-decoration-none">
                                                @c.Name
                                            </a>
                                        </td>
                                        <td>@c.Phone</td>
                                        <td class="text-truncate" style="max-width: 200px;">@c.Address</td>
                                        <td class="text-end fw-bold text-dark">@c.CreditLimit.ToString("N0") đ</td>
                                        <td class="text-center">@c.PaymentTermDays ngày</td>
                                        <td class="text-center">
                                            @if (c.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">Đã khóa</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a href="customers/@c.Id" class="btn btn-outline-info" title="Xem chi tiết công nợ">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(c)" title="Chỉnh sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                @if (c.IsActive)
                                                {
                                                    <button class="btn btn-outline-danger" @onclick="() => ConfirmDeactivate(c.Id, c.Name)" title="Ngừng hoạt động">
                                                        <i class="bi bi-person-x"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        Không tìm thấy khách hàng nào phù hợp.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Form Thêm / Sửa Khách hàng (EditForm + DataAnnotations) -->
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-person-vcard text-primary me-2"></i>@(_isEditing ? "Chỉnh sửa Khách hàng" : "Thêm mới Khách hàng")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="_model" OnValidSubmit="HandleSaveCustomer">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold">Mã khách hàng <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_model.Code" disabled="@_isEditing" placeholder="VD: KH006" />
                                <ValidationMessage For="() => _model.Code" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-8">
                                <label class="form-label fw-semibold">Tên khách hàng <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_model.Name" placeholder="VD: Tạp hóa Hưng Thịnh" />
                                <ValidationMessage For="() => _model.Name" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_model.Phone" placeholder="VD: 0901234567" />
                                <ValidationMessage For="() => _model.Phone" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Địa chỉ <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_model.Address" placeholder="VD: 123 Lê Duẩn, Hà Nội" />
                                <ValidationMessage For="() => _model.Address" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Hạn mức tín dụng (VNĐ) <span class="text-danger">*</span></label>
                                <InputNumber class="form-control" @bind-Value="_model.CreditLimit" />
                                <ValidationMessage For="() => _model.CreditLimit" class="text-danger small" />
                                <div class="form-text small">Mức công nợ tối đa cho phép mua chịu.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Thời hạn nợ (Ngày) <span class="text-danger">*</span></label>
                                <InputNumber class="form-control" @bind-Value="_model.PaymentTermDays" />
                                <ValidationMessage For="() => _model.PaymentTermDays" class="text-danger small" />
                                <div class="form-text small">Số ngày tối đa trước khi tính quá hạn.</div>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox class="form-check-input" id="isActiveCheck" @bind-Value="_model.IsActive" />
                                    <label class="form-check-label fw-semibold" for="isActiveCheck">Đang hoạt động (Cho phép giao dịch)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu thông tin
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="_showConfirmDialog" 
               Title="Xác nhận ngừng hoạt động" 
               Message="@($"Bạn có chắc chắn muốn ngừng hoạt động khách hàng '{_deactivateName}'?")" 
               OnConfirmation="HandleDeactivateConfirm" />

@code {
    private bool _loading = true;
    private List<Customer> _customers = new();
    private string _searchTerm = "";
    private string _filterStatus = "all";
    private string? _statusMessage;
    private string? _errorMessage;

    private bool _showModal = false;
    private bool _isEditing = false;
    private CustomerModel _model = new();

    private bool _showConfirmDialog = false;
    private int _deactivateId;
    private string _deactivateName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _loading = true;
        try
        {
            _customers = (await ViewCustomersUseCase.ExecuteAsync()).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<Customer> FilteredCustomers => _customers.Where(c =>
    {
        bool matchSearch = string.IsNullOrWhiteSpace(_searchTerm) ||
                           c.Code.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           c.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           c.Phone.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase);

        bool matchStatus = _filterStatus switch
        {
            "active" => c.IsActive,
            "inactive" => !c.IsActive,
            _ => true
        };

        return matchSearch && matchStatus;
    });

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new CustomerModel
        {
            Code = $"KH00{_customers.Count + 1}",
            CreditLimit = 20000000m,
            PaymentTermDays = 30,
            IsActive = true
        };
        _showModal = true;
    }

    private void OpenEditModal(Customer customer)
    {
        _isEditing = true;
        _model = new CustomerModel
        {
            Id = customer.Id,
            Code = customer.Code,
            Name = customer.Name,
            Phone = customer.Phone,
            Address = customer.Address,
            CreditLimit = customer.CreditLimit,
            PaymentTermDays = customer.PaymentTermDays,
            IsActive = customer.IsActive
        };
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private async Task HandleSaveCustomer()
    {
        try
        {
            _errorMessage = null;
            if (_isEditing)
            {
                var cust = new Customer
                {
                    Id = _model.Id,
                    Code = _model.Code,
                    Name = _model.Name,
                    Phone = _model.Phone,
                    Address = _model.Address,
                    CreditLimit = _model.CreditLimit,
                    PaymentTermDays = _model.PaymentTermDays,
                    IsActive = _model.IsActive
                };
                await EditCustomerUseCase.ExecuteAsync(cust);
                _statusMessage = $"Đã cập nhật thông tin khách hàng {_model.Name} thành công!";
            }
            else
            {
                var cust = new Customer
                {
                    Code = _model.Code,
                    Name = _model.Name,
                    Phone = _model.Phone,
                    Address = _model.Address,
                    CreditLimit = _model.CreditLimit,
                    PaymentTermDays = _model.PaymentTermDays,
                    IsActive = _model.IsActive
                };
                await AddCustomerUseCase.ExecuteAsync(cust);
                _statusMessage = $"Đã thêm mới khách hàng {_model.Name} thành công!";
            }

            _showModal = false;
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ConfirmDeactivate(int id, string name)
    {
        _deactivateId = id;
        _deactivateName = name;
        _showConfirmDialog = true;
    }

    private async Task HandleDeactivateConfirm(bool confirmed)
    {
        _showConfirmDialog = false;
        if (confirmed)
        {
            try
            {
                await DeleteCustomerUseCase.ExecuteAsync(_deactivateId);
                _statusMessage = $"Đã chuyển trạng thái ngừng hoạt động cho khách hàng '{_deactivateName}'.";
                await LoadCustomers();
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
            }
        }
    }
}
