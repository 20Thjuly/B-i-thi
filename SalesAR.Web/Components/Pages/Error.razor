@page "/Error"
@using System.Diagnostics

<PageTitle>Thông Báo Lỗi - SalesAR</PageTitle>

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 rounded-4 mx-auto p-4 p-md-5" style="max-width: 600px; background: #fff;">
        <div class="text-danger mb-3">
            <i class="bi bi-exclamation-octagon-fill display-1"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">Đã Xảy Ra Lỗi Hệ Thống</h2>
        <p class="text-muted mb-4">
            Hệ thống đã ghi nhận sự cố kỹ thuật và đã ngăn chặn việc lộ thông tin bảo mật (Stack Trace). Quý người dùng vui lòng thử lại hoặc liên hệ Quản trị viên hệ thống để được hỗ trợ.
        </p>

        @if (ShowRequestId)
        {
            <div class="p-2 bg-light rounded-3 border mb-4 font-monospace small text-muted">
                Mã theo dõi yêu cầu (Correlation ID): <strong>@RequestId</strong>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="dashboard" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-house-door-fill me-1"></i> Về Trang Chủ Dashboard
            </a>
            <a href="login" class="btn btn-outline-secondary px-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Lại
            </a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
