<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center" href="dashboard">
            <i class="bi bi-wallet2 text-primary me-2 fs-5"></i>Sales & AR
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <!-- 1. Tổng quan chung -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </NavLink>
                </div>

                <!-- 2. Nhóm Bán hàng (SALES & ADMIN) -->
                <AuthorizeView Roles="ADMIN,SALES" Context="salesContext">
                    <div class="px-3 pt-3 pb-1 text-uppercase text-white-50" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
                        Nghiệp vụ Bán hàng
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="customers">
                            <i class="bi bi-people-fill me-2 text-info"></i> Khách hàng
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="products">
                            <i class="bi bi-box-seam me-2 text-info"></i> Hàng hóa
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="invoices">
                            <i class="bi bi-receipt me-2 text-info"></i> Hóa đơn bán
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- 3. Nhóm Kế toán & Công nợ (ACCOUNTANT & ADMIN) -->
                <AuthorizeView Roles="ADMIN,ACCOUNTANT" Context="accContext">
                    <div class="px-3 pt-3 pb-1 text-uppercase text-white-50" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
                        Kế toán & Công nợ
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="debt">
                            <i class="bi bi-card-checklist me-2 text-success"></i> Tổng hợp Công nợ
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="payments">
                            <i class="bi bi-cash-stack me-2 text-success"></i> Thu tiền (FIFO)
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="aging-report">
                            <i class="bi bi-graph-up-arrow me-2 text-success"></i> Báo cáo Tuổi nợ
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- Trường hợp chỉ có quyền SALES vẫn được xem công nợ khách hàng -->
                <AuthorizeView Roles="SALES" Context="salesOnlyContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="debt">
                            <i class="bi bi-card-checklist me-2 text-warning"></i> Xem Công nợ
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- 4. Nhóm Quản trị Hệ thống (CHỈ DÀNH CHO ADMIN) -->
                <AuthorizeView Roles="ADMIN" Context="adminContext">
                    <div class="px-3 pt-3 pb-1 text-uppercase text-white-50" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
                        Quản trị Hệ thống
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link text-warning" href="admin/users">
                            <i class="bi bi-people-gear me-2"></i> Người dùng
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link text-warning" href="admin/roles">
                            <i class="bi bi-shield-check me-2"></i> Vai trò & Quyền
                        </NavLink>
                    </div>
                </AuthorizeView>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <i class="bi bi-box-arrow-in-right me-2 text-primary"></i> Đăng nhập
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
