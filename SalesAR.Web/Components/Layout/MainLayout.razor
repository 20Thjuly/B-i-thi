@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-3 px-md-4 d-flex justify-content-between align-items-center">
            <!-- Left Header: System branding & status pill -->
            <div class="d-flex align-items-center gap-2 gap-md-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3 p-1 p-md-2" style="width: 32px; height: 32px;">
                        <i class="bi bi-wallet2 fs-6"></i>
                    </span>
                    <div>
                        <div class="fw-bold text-dark d-none d-sm-block" style="font-size: 0.925rem; letter-spacing: -0.01em;">
                            Sales &amp; Accounts Receivable
                        </div>
                        <div class="text-muted d-none d-md-block" style="font-size: 0.725rem;">
                            Quản lý Bán hàng &amp; Công nợ Khách hàng
                        </div>
                    </div>
                </div>

                <div class="vr mx-2 d-none d-md-block" style="height: 20px; opacity: 0.2;"></div>

                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 d-none d-lg-inline-flex align-items-center" style="font-size: 0.75rem;">
                    <span class="spinner-grow spinner-grow-sm me-1 text-success" style="width: 6px; height: 6px;" role="status"></span>
                    Hệ thống Trực tuyến
                </span>
            </div>

            <!-- Right Header: User profile & quick actions -->
            <div>
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2 gap-md-3">
                            @{
                                var userName = context.User.Identity?.Name ?? "Người dùng";
                                var role = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "USER";
                                var initial = string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpper();
                                var roleClass = role switch {
                                    "ADMIN" => "badge-soft-danger",
                                    "SALES" => "badge-soft-primary",
                                    "ACCOUNTANT" => "badge-soft-success",
                                    _ => "badge-soft-secondary"
                                };
                            }

                            <!-- User Info Capsule -->
                            <div class="d-flex align-items-center gap-2 bg-light px-2 py-1 px-md-3 py-md-1.5 rounded-pill border">
                                <div class="user-avatar text-white fw-bold d-flex align-items-center justify-content-center rounded-circle" 
                                     style="width: 28px; height: 28px; font-size: 0.8rem; background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
                                    @initial
                                </div>
                                <div class="d-flex flex-column text-start d-none d-sm-flex">
                                    <span class="fw-semibold text-dark" style="font-size: 0.825rem; line-height: 1.1;">@userName</span>
                                </div>
                                <span class="badge @roleClass" style="font-size: 0.7rem; padding: 0.25em 0.55em;">
                                    @role
                                </span>
                            </div>

                            <!-- GitHub Repository Link -->
                            <a href="https://github.com/20Thjuly/B-i-thi" target="_blank" class="btn btn-sm btn-outline-dark d-flex align-items-center gap-1 text-decoration-none" title="Xem mã nguồn trên GitHub (20Thjuly/B-i-thi)">
                                <i class="bi bi-github fs-6"></i>
                                <span class="d-none d-lg-inline fw-semibold" style="font-size: 0.8rem;">GitHub</span>
                            </a>

                            <!-- Logout Button -->
                            <a href="logout" class="btn btn-sm btn-outline-danger" title="Đăng xuất khỏi hệ thống">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-md-inline ms-1">Đăng xuất</span>
                            </a>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="https://github.com/20Thjuly/B-i-thi" target="_blank" class="btn btn-sm btn-outline-dark d-flex align-items-center gap-1 text-decoration-none" title="Xem mã nguồn trên GitHub">
                                <i class="bi bi-github fs-6"></i>
                                <span class="d-none d-sm-inline fw-semibold" style="font-size: 0.8rem;">GitHub</span>
                            </a>
                            <a href="login" class="btn btn-sm btn-primary">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-3 px-md-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    <span>Đã xảy ra lỗi không mong muốn trên hệ thống.</span>
    <a href="" class="reload text-primary fw-semibold ms-2">Tải lại trang</a>
    <a class="dismiss">🗙</a>
</div>
