@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm">
            <div class="d-flex align-items-center text-muted small">
                <i class="bi bi-building me-2 text-primary fs-5"></i>
                <span class="fw-semibold text-dark">Hệ thống Quản lý Bán hàng &amp; Công nợ Khách hàng</span>
            </div>

            <div>
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle fs-5 text-primary"></i>
                                <span class="fw-semibold text-dark small">@context.User.Identity?.Name</span>
                                @{
                                    var role = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "USER";
                                }
                                <span class="badge @(role == "ADMIN" ? "bg-danger" : (role == "SALES" ? "bg-primary" : "bg-success"))" style="font-size: 0.75rem;">
                                    @role
                                </span>
                            </div>
                            <a href="logout" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center">
                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                            </a>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn btn-sm btn-primary d-inline-flex align-items-center">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
