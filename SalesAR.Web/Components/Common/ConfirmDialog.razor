@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-exclamation-triangle-fill fs-6"></i>
                        </div>
                        <h5 class="modal-title fw-bold text-dark mb-0 fs-6">
                            @Title
                        </h5>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => OnConfirmation.InvokeAsync(false)"></button>
                </div>
                <div class="modal-body py-4 px-4 bg-white">
                    <p class="mb-0 text-secondary fs-6" style="line-height: 1.5;">@Message</p>
                </div>
                <div class="modal-footer bg-light border-top py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OnConfirmation.InvokeAsync(false)">
                        <i class="bi bi-x-circle me-1"></i>Hủy bỏ
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => OnConfirmation.InvokeAsync(true)">
                        <i class="bi bi-check2-circle me-1"></i>Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Xác nhận";
    [Parameter] public string Message { get; set; } = "Bạn có chắc chắn muốn thực hiện thao tác này?";
    [Parameter] public EventCallback<bool> OnConfirmation { get; set; }
}
