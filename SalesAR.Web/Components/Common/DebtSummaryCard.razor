<div class="card h-100 card-hover-lift @CardClass">
    <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.04em;">@Title</span>
                <div class="d-flex align-items-center justify-content-center rounded-3 bg-light text-primary border" style="width: 38px; height: 38px;">
                    <i class="bi @Icon fs-5"></i>
                </div>
            </div>
            <div class="fs-4 fs-md-3 fw-bold text-dark mb-1 tabular-nums">
                @Amount.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="small text-muted mt-2 d-flex align-items-center gap-1" style="font-size: 0.775rem;">
                <i class="bi bi-info-circle text-muted" style="font-size: 0.75rem;"></i>
                <span>@Subtitle</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-cash-coin";
    [Parameter] public string CardClass { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
}
