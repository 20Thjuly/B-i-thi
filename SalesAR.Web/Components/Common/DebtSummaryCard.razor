<div class="card shadow-sm border-0 h-100 rounded-3 @CardClass">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted small fw-semibold text-uppercase">@Title</span>
            <div class="rounded-circle p-2 bg-light text-primary">
                <i class="bi @Icon fs-5"></i>
            </div>
        </div>
        <div class="fs-4 fs-md-3 fw-bold mb-1 text-truncate">
            @Amount.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span>
        </div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="small text-muted">@Subtitle</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-cash-coin";
    [Parameter] public string CardClass { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
}
