@switch (Status?.Trim())
{
    case "Paid":
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
            <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
        </span>
        break;
    case "PartiallyPaid":
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill">
            <i class="bi bi-pie-chart-fill me-1"></i>Thanh toán 1 phần
        </span>
        break;
    case "Unpaid":
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
            <i class="bi bi-clock-fill me-1"></i>Chưa thanh toán
        </span>
        break;
    case "Draft":
        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
            <i class="bi bi-file-earmark me-1"></i>Bản nháp
        </span>
        break;
    case "Cancelled":
        <span class="badge bg-dark-subtle text-dark border border-dark-subtle px-2 py-1 rounded-pill">
            <i class="bi bi-x-circle me-1"></i>Đã hủy
        </span>
        break;
    default:
        <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">
            @(Status ?? "Không rõ")
        </span>
        break;
}

@code {
    [Parameter] public string Status { get; set; } = string.Empty;
}
