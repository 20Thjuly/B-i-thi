@switch (Status?.Trim())
{
    case "Paid":
        <span class="badge badge-soft-success rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1">
            <i class="bi bi-check-circle-fill" style="font-size: 0.75rem;"></i>
            <span>Đã thanh toán</span>
        </span>
        break;
    case "PartiallyPaid":
        <span class="badge badge-soft-warning rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1">
            <i class="bi bi-pie-chart-fill" style="font-size: 0.75rem;"></i>
            <span>Thanh toán 1 phần</span>
        </span>
        break;
    case "Unpaid":
        <span class="badge badge-soft-danger rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1">
            <i class="bi bi-clock-fill" style="font-size: 0.75rem;"></i>
            <span>Chưa thanh toán</span>
        </span>
        break;
    case "Draft":
        <span class="badge badge-soft-secondary rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1">
            <i class="bi bi-file-earmark" style="font-size: 0.75rem;"></i>
            <span>Bản nháp</span>
        </span>
        break;
    case "Cancelled":
        <span class="badge badge-soft-secondary rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1 text-decoration-line-through">
            <i class="bi bi-x-circle" style="font-size: 0.75rem;"></i>
            <span>Đã hủy</span>
        </span>
        break;
    default:
        <span class="badge badge-soft-secondary rounded-pill px-2.5 py-1">
            @(Status ?? "Không rõ")
        </span>
        break;
}

@code {
    [Parameter] public string Status { get; set; } = string.Empty;
}
